upd_knight_21
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_knight_d
upd_knight_next
 rem ---- Shadow: steers toward the nearest Knight, velocity (alternate frames), walls: slide, edges: stop ----
 mi = 1
 if otype[mi] <> T_SHADOW then goto upd_shadow_next
 tmp = mi ^ frame
 tmp = tmp & 1
 if tmp then goto upd_shadow_next
 sk = 0
 if otype[sk] <> T_KNIGHT then goto upd_shadow_str
 ovx[mi] = 0 : ovxl[mi] = 0
