 if otype[oi] <> T_KNIGHT then goto rule5_ni
rule5_nj_5
rule5_ni
rule5_end

 rem rule 6: When a Knight is on spikes: take 1 from Lives, send every Knight back to start, protect
 rem   every Knight for 1.5 seconds and play Falling tone.
rule6
 if oddframe = 0 then goto rule6_end
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule6_next
 if oprot[oi] then goto rule6_next
 px = ox[oi] + 4 : py = oy[oi] + 7
 if py > 191 then goto rule6_off_8
 if py < ROOMTOP then goto rule6_off_8
 if px > 159 then goto rule6_off_8
 gosub wallat
 if cell = 2 then goto rule6_hit
rule6_off_8
 goto rule6_next
rule6_hit
 gosub rule6_do
 if ruleexit then return
rule6_next
rule6_end

 rem rule 7: When Knight touches Crown: add 500 points, play Chime and win the game.
rule7
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule7_ni
 if oprot[oi] then goto rule7_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 4
 if otype[oj] <> T_CROWN then goto rule7_nj_11
 if oprot[oj] then goto rule7_nj_11
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 14, x2, y2, 8, 8) then gosub rule7_do
 if ruleexit then return
 if otype[oi] <> T_KNIGHT then goto rule7_ni
rule7_nj_11
rule7_ni
rule7_end

 rem rule 8: When Lives is 0: lose the game.
rule8
 if oddframe = 0 then goto rule8_end
 if lives <> 0 then goto rule8_off
 if latches{0} then goto rule8_end
 latches{0} = 1
 gosub rule8_do
 if ruleexit then return
 goto rule8_end
rule8_off
 latches{0} = 0
rule8_end

 return

 rem ---- rules run by other code: room start, created, destroyed, timer out ----

 rem ---- what each rule does ----
rule1_do
 ds = oj : gosub kill_key
 tmp = 1
 if tmp > 99 then tmp = 99
 cnt_keys = cnt_keys + tmp
 if cnt_keys > 99 then cnt_keys = 99
 score0 = score0 + 50
 playsfx sfx_up
 return

rule2_do
 ds = oj : gosub kill_door
 tmp = 1
 if cnt_keys < tmp then cnt_keys = 0 else cnt_keys = cnt_keys - tmp
 score0 = score0 + 100
 playsfx sfx_chime
 return

rule3_do
 ox[oi] = osx[oi] : oy[oi] = osy[oi]
 playsfx sfx_down
 return

rule4_do
 ds = oj : gosub kill_gem
 score0 = score0 + 20
 playsfx sfx_blip
 return

rule5_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_KNIGHT then goto tgt_6
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_6
 ak = 0
 if otype[ak] <> T_KNIGHT then goto tgt_7
 oprot[ak] = 15
tgt_7
 playsfx sfx_crash
 return

rule6_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_KNIGHT then goto tgt_9
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_9
 ak = 0
 if otype[ak] <> T_KNIGHT then goto tgt_10
 oprot[ak] = 15
tgt_10
 playsfx sfx_down
 return

rule7_do
 score0 = score0 + 500
 playsfx sfx_chime
 gamestate = STATE_WON : statesecs = 0 : ruleexit = 1
 rem audio: the winning jingle plays here (reserved for kit/audio.ts)
 return

