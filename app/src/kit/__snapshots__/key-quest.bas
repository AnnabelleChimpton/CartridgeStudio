 rem ---- timers: four slots a frame, so each slot counts down every tenth of a second ----
tick
 tick6 = tick6 + 1
 if tick6 >= 6 then tick6 = 0
 tk = tick6 * 4 : tend = tk + 4
tickloop
 if oprot[tk] then oprot[tk] = oprot[tk] - 1
ticknext
 tk = tk + 1
 if tk < tend then goto tickloop
 return

 rem ---- rules (generated from the project), in order ----
rules
 oddframe = frame & 1
 rem rule 1: When Cat touches Key: remove the Key, add 1 to Keys, add 50 points and play Rising tone.
rule1
 oi = 0
 if otype[oi] <> T_CAT then goto rule1_ni
 if oprot[oi] then goto rule1_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 2
 if otype[oj] <> T_KEY then goto rule1_nj_1
 if oprot[oj] then goto rule1_nj_1
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 8, 6) then gosub rule1_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule1_ni
rule1_nj_1
rule1_ni
rule1_end

 rem rule 2: When Cat touches Pantry door, only if Keys is at least 1: remove the Pantry door, take 1
 rem   from Keys, add 100 points and play Chime.
rule2
 if c_keys < 1 then goto rule2_end
 oi = 0
 if otype[oi] <> T_CAT then goto rule2_ni
 if oprot[oi] then goto rule2_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 3
 if otype[oj] <> T_DOOR then goto rule2_nj_2
 if oprot[oj] then goto rule2_nj_2
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 16, 16) then gosub rule2_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule2_ni
rule2_nj_2
rule2_ni
rule2_end

 rem rule 3: When Cat touches Pantry door, only if Keys is 0: send the Cat back to start and play Falling
 rem   tone.
rule3
 if c_keys <> 0 then goto rule3_end
 oi = 0
 if otype[oi] <> T_CAT then goto rule3_ni
 if oprot[oi] then goto rule3_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 3
 if otype[oj] <> T_DOOR then goto rule3_nj_3
 if oprot[oj] then goto rule3_nj_3
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 16, 16) then gosub rule3_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule3_ni
rule3_nj_3
rule3_ni
rule3_end

 rem rule 4: When Cat touches Cat treat: remove the Cat treat, add 20 points and play Blip.
rule4
 oi = 0
 if otype[oi] <> T_CAT then goto rule4_ni
 if oprot[oi] then goto rule4_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 5
 if otype[oj] <> T_TREAT then goto rule4_nj_4
 if oprot[oj] then goto rule4_nj_4
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 4, 6) then gosub rule4_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule4_ni
rule4_nj_4
rule4_ni
rule4_end

 rem rule 5: When Cat touches Robot vacuum: take 1 from Lives, send every Cat back to start, protect
 rem   every Cat for 1.5 seconds and play Crash.
rule5
 oi = 0
 if otype[oi] <> T_CAT then goto rule5_ni
 if oprot[oi] then goto rule5_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 1
 if otype[oj] <> T_ROBOT then goto rule5_nj_5
 if oprot[oj] then goto rule5_nj_5
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 12, 6) then gosub rule5_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule5_ni
rule5_nj_5
rule5_ni
rule5_end

 rem rule 6: When a Cat is on spikes: take 1 from Lives, send every Cat back to start, protect every Cat
 rem   for 1.5 seconds and play Falling tone.
rule6
 if oddframe = 0 then goto rule6_end
 oi = 0
 if otype[oi] <> T_CAT then goto rule6_next
 if oprot[oi] then goto rule6_next
 px = ox[oi] + 4 : py = oy[oi] + 5
 if py > 191 then goto rule6_off_8
 if py < ROOMTOP then goto rule6_off_8
 if px > 159 then goto rule6_off_8
 gosub wallat
 if cell = 2 then goto rule6_hit
rule6_off_8
 goto rule6_next
rule6_hit
 gosub rule6_do
 if ruleexit then return
rule6_next
rule6_end

 rem rule 7: When Cat touches Sardines: add 500 points, play Chime and win the game.
rule7
 oi = 0
 if otype[oi] <> T_CAT then goto rule7_ni
 if oprot[oi] then goto rule7_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 4
 if otype[oj] <> T_SARDINES then goto rule7_nj_11
 if oprot[oj] then goto rule7_nj_11
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 10, x2, y2, 8, 8) then gosub rule7_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule7_ni
rule7_nj_11
rule7_ni
rule7_end

 rem rule 8: When Lives is 0: lose the game.
rule8
 if oddframe = 0 then goto rule8_end
 if lives <> 0 then goto rule8_off
 if latches{0} then goto rule8_end
 latches{0} = 1
 gosub rule8_do
 if ruleexit then return
 goto rule8_end
rule8_off
 latches{0} = 0
rule8_end

 return

 rem ---- rules run by other code: room start, created, destroyed, timer out ----

 rem ---- what each rule does ----
rule1_do
 ds = oj : gosub kill_key
 tmp = 1
 if tmp > 99 then tmp = 99
 c_keys = c_keys + tmp
 if c_keys > 99 then c_keys = 99
 score0 = score0 + 50
 playsfx sfx_up
 return

rule2_do
 ds = oj : gosub kill_door
 tmp = 1
 if c_keys < tmp then c_keys = 0 else c_keys = c_keys - tmp
 score0 = score0 + 100
 playsfx sfx_chime
 return

rule3_do
 ox[oi] = osx[oi] : oy[oi] = osy[oi]
 playsfx sfx_down
 return

rule4_do
 ds = oj : gosub kill_treat
 score0 = score0 + 20
 playsfx sfx_blip
 return

rule5_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_6
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_6
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_7
 oprot[ak] = 15
tgt_7
 playsfx sfx_crash
 return

rule6_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_9
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_9
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_10
 oprot[ak] = 15
tgt_10
 playsfx sfx_down
 return

rule7_do
 score0 = score0 + 500
 playsfx sfx_chime
 gamestate = STATE_WON : statesecs = 0 : ruleexit = 1
 rem audio: the winning jingle plays here (reserved for kit/audio.ts)
 return

rule8_do
 gamestate = STATE_LOST : statesecs = 0 : ruleexit = 1
 rem audio: the losing jingle plays here (reserved for kit/audio.ts)
 return

