 autodim byte hud2
 autodim byte endbcd0

 const STATE_TITLE = 0
 const STATE_PLAY = 1
 const STATE_WON = 2
 const STATE_LOST = 3
 const STATE_ATTRACT = 4
 const EMPTY = 255
 const ROOMTOP = 16
 const T_KNIGHT = 0
 const T_SHADOW = 1
 const T_KEY = 2
 const T_DOOR = 3
 const T_CROWN = 4
 const T_GEM = 5
 const TILE_WALL = 1
 const TILE_HAZARD = 2
 const TILE_GOAL = 3
 const ROOMS = 4

 rem per-thing tables: 24 slots each (see the memory map)
 dim otype = $2200
 dim ox = $2218
 dim oy = $2230
 dim ofx = $2248
 dim ofy = $2260
 dim ovx = $2278
 dim ovxl = $2290
 dim ovy = $22A8
 dim ovyl = $22C0
 dim osx = $22D8
 dim osy = $22F0
 dim oprot = $2308
 dim oplace = $2320
 dim cnt_keys = $2338
 dim taken = $2339
 dim roomwalls = $2345

 rem Knight
 incgraphic spr_knight.png 160A 0 1 2 3
 rem Shadow
 incgraphic spr_shadow.png 160A 0 1 2 3
 rem Shadow frame 2
 incgraphic spr_shadow_2.png 160A 0 1 2 3
 rem Key
 incgraphic spr_key.png 160A 0 1 2 3
 rem Locked door
 incgraphic spr_door.png 160A 0 1 2 3
 rem Crown
 incgraphic spr_crown.png 160A 0 1 2 3
 rem Gem
 incgraphic spr_gem.png 160A 0 1 2 3
 incgraphic font.png 160A 0 1 2 3
 characterset font
 alphachars '0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ.!?-:#~*'

 rem palette knight
 P0C1 = $1A : P0C2 = $0F : P0C3 = $84
 rem palette shadow
 P1C1 = $54 : P1C2 = $0F : P1C3 = $42
 rem palette gold
 P2C1 = $1C : P2C2 = $1A : P2C3 = $46
 rem palette door
 P3C1 = $22 : P3C2 = $26 : P3C3 = $20
 rem palette walls
 P4C1 = $94 : P4C2 = $92 : P4C3 = $90
 rem palette text
 P5C1 = $0F : P5C2 = $0F : P5C3 = $0F
 BACKGRND = $00

 roomi = 0 : drawnroom = 255
 latches = 0 : latches2 = 0
 lives = 3
 cnt_keys = 0
 rem audio: a later title tune and jingles start here (kit/audio.ts reserves this spot)
 rem ---- user_init: your code, once at power-on ----
 rem (empty)

 gamestate = STATE_TITLE
 gosub startroom

main
 restorescreen
 frame = frame + 1
 rem count main-loop passes (frame-rate checks read this)
 loopslo = loopslo + 1
 if loopslo = 0 then loopshi = loopshi + 1
 rem audio: the per-frame music call goes here (reserved for kit/audio.ts)
 rem console Reset goes back to the title screen, once per press; Select is reserved
 if !switchreset then resetheld = 0
 if switchreset && resetheld = 0 then resetheld = 1 : gosub totitle
 rem joystick 1 as bits: 1 up, 2 down, 4 left, 8 right, 16 fire
 pad1 = 0
 if joy0up then pad1 = pad1 | 1
 if joy0down then pad1 = pad1 | 2
 if joy0left then pad1 = pad1 | 4
 if joy0right then pad1 = pad1 | 8
 if joy0fire then pad1 = pad1 | 16

 rem the demo plays recorded input; anything real ends it
 if gamestate <> STATE_ATTRACT then goto notdemo
 if pad1 then gosub totitle : goto notdemo
 gosub demoread
notdemo

 tmp = padprev ^ 255 : padpressed = pad1 & tmp
 tmp = pad1 ^ 255 : padreleased = padprev & tmp
 padprev = pad1
 on gamestate goto st_title st_play st_end st_end st_play

st_title

 gosub statetick
 if statesecs >= 20 then gosub startdemo : goto draw

 if padpressed{4} then gosub newgame
 goto draw

st_end
 if demo then gosub totitle : goto draw

 if padpressed{4} then gosub totitle
 goto draw

st_play
 ruleexit = 0
 secondtick = secondtick + 1
 if secondtick >= 60 then secondtick = 0 : seconds = seconds + 1

 gosub tick
 if ruleexit then goto draw

 gosub moveall

 if goroom then gosub changeroom

 rem ---- user_frame: your code, once a frame, after movement and before the rules ----
 rem (empty)
 if ruleexit then goto draw
 gosub rules
 if ruleexit then goto draw
 rem nothing leaves the screen and waits for a rule
 goto draw

draw
 plotvalue font 5 score0 6 4 0
 hud1 = converttobcd(cnt_keys)
 plotvalue font 5 hud1 2 76 0
 hud2 = converttobcd(lives)
 plotvalue font 5 hud2 2 152 0
 rem Knight
 oi = 0
 if otype[oi] <> T_KNIGHT then goto drw_knight_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_knight_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_knight 0 px py
drw_knight_next
 rem Shadow
 oi = 1
 if otype[oi] <> T_SHADOW then goto drw_shadow_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_shadow_next
 px = ox[oi] : py = oy[oi]
 fr = 0
 tmp = frame & 8
 if tmp then fr = fr + 1
 plotsprite4 spr_shadow 1 px py fr
drw_shadow_next
 rem Key
 oi = 2
 if otype[oi] <> T_KEY then goto drw_key_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_key_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_key 2 px py
drw_key_next
 rem Locked door
 oi = 3
 if otype[oi] <> T_DOOR then goto drw_door_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_door_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_door 3 px py
drw_door_next
 rem Crown
 oi = 4
 if otype[oi] <> T_CROWN then goto drw_crown_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_crown_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_crown 2 px py
drw_crown_next
 rem Gem
 oi = 5
 if otype[oi] <> T_GEM then goto drw_gem_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_gem_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_gem 2 px py
drw_gem_next
 rem ---- user_draw: your code, after the things are drawn ----
 rem (empty)
 if gamestate = STATE_TITLE then gosub drawtitle
 if gamestate = STATE_WON then gosub drawwon
 if gamestate = STATE_LOST then gosub drawlost

 if gamestate = STATE_ATTRACT then gosub drawdemo

 drawscreen
 goto main

 rem ---- game flow ----
newgame
 score0 = 0
 latches = 0 : latches2 = 0
 demo = 0 : roomi = 0
 lives = 3
 cnt_keys = 0

 for rk = 0 to 11 : taken[rk] = 0 : next

 gamestate = STATE_PLAY
 gosub startroom
 return

totitle
 gamestate = STATE_TITLE : statesecs = 0 : stateframes = 0 : demo = 0
 roomi = 0
 gosub startroom
 return

statetick
 stateframes = stateframes + 1
 if stateframes >= 60 then stateframes = 0 : statesecs = statesecs + 1
 return

startdemo
 gosub newgame
 gamestate = STATE_ATTRACT : demo = 1
 demoi = 0 : demon = demoinput[1]
 return

demoread
 if demon = 0 then gosub totitle : return
 pad1 = demoinput[demoi]
 demon = demon - 1
 if demon then return
 demoi = demoi + 2
 tmp = demoi + 1 : demon = demoinput[tmp]
 return

startroom
 rem the room's walls are drawn once and saved; starting the same room again (a new game,
 rem the title, "start the room again") keeps them, so a restart fits in its frame
 if drawnroom = roomi then goto srdrawn
 clearscreen
 if roomi <> 0 then goto srmap0
 plotmap roommap0 4 0 2 20 22 0 0 40
 plotmap roommap0 4 80 2 20 22 20 0 40
 for rk = 0 to 219 : roomwalls[rk] = roomtiles0[rk] : next
srmap0
 if roomi <> 1 then goto srmap1
 plotmap roommap1 4 0 2 20 22 0 0 40
 plotmap roommap1 4 80 2 20 22 20 0 40
 for rk = 0 to 219 : roomwalls[rk] = roomtiles1[rk] : next
srmap1
 if roomi <> 2 then goto srmap2
 plotmap roommap2 4 0 2 20 22 0 0 40
 plotmap roommap2 4 80 2 20 22 20 0 40
 for rk = 0 to 219 : roomwalls[rk] = roomtiles2[rk] : next
srmap2
 if roomi <> 3 then goto srmap3
 plotmap roommap3 4 0 2 20 22 0 0 40
 plotmap roommap3 4 80 2 20 22 20 0 40
 for rk = 0 to 219 : roomwalls[rk] = roomtiles3[rk] : next
srmap3
 savescreen
 drawnroom = roomi
srdrawn
 roomnum = roomi + 1
 if keepplayers = 0 then goto srclearall
 otype[1] = EMPTY
 otype[2] = EMPTY
 otype[3] = EMPTY
 otype[4] = EMPTY
 otype[5] = EMPTY
 otype[6] = EMPTY
 otype[7] = EMPTY
 otype[8] = EMPTY
 otype[9] = EMPTY
 otype[10] = EMPTY
 otype[11] = EMPTY
 otype[12] = EMPTY
 otype[13] = EMPTY
 otype[14] = EMPTY
 otype[15] = EMPTY
 otype[16] = EMPTY
 otype[17] = EMPTY
 otype[18] = EMPTY
 otype[19] = EMPTY
 otype[20] = EMPTY
 otype[21] = EMPTY
 otype[22] = EMPTY
 otype[23] = EMPTY
 oi = 0
 if otype[oi] <> T_KNIGHT then goto keep_30
 osx[oi] = ox[oi] : osy[oi] = oy[oi]
keep_30
 goto srcleared
srclearall
 for oi = 0 to 23 : otype[oi] = EMPTY : next
srcleared
 tk = roomfirst[roomi] : tend = roomend[roomi]
 if tk = tend then goto srplaced
srplace
 sl = spslot[tk]
 if otype[sl] <> EMPTY then goto srnext
 tmp = sptakebyte[tk] : tmp2 = taken[tmp] & sptakebit[tk]
 if tmp2 then goto srnext
 oplace[sl] = tk
 ot = sptype[tk] : otype[sl] = ot
 ox[sl] = spx[tk] : oy[sl] = spy[tk]
 osx[sl] = ox[sl] : osy[sl] = oy[sl]
 ofx[sl] = 0 : ofy[sl] = 0
 ovx[sl] = typevx[ot] : ovxl[sl] = typevxl[ot]
 ovy[sl] = typevy[ot] : ovyl[sl] = typevyl[ot]
 oprot[sl] = 0
srnext
 tk = tk + 1
 if tk < tend then goto srplace
srplaced
 rem nothing resets per room
 seconds = 0 : secondtick = 0 : msgs = 0
 if gamestate = STATE_TITLE then goto startroomdone
 rem audio: a room's music starts here (reserved for kit/audio.ts)
 rem no room start rules
startroomdone
 rem ---- user_startroom: your code, at the end of every room start ----
 rem (empty)
 return

 rem through an exit: the things a joystick moves come along, and start from where they came in
changeroom
 roomi = goroom - 1 : goroom = 0
 keepplayers = 1 : gosub startroom : keepplayers = 0
 ruleexit = 1
 return

 rem ---- movement: one compiled loop per kind of thing ----
moveall
 rem ---- Knight: joystick 1 (4way, direct), velocity, walls: slide, edges: stop ----
 mi = 0
