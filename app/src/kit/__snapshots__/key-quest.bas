 if oy[mi] = tmp then goto upd_shadow_27
upd_shadow_26
 ovy[mi] = 255 : ovyl[mi] = 192
 goto upd_shadow_27
upd_shadow_25
 ovy[mi] = 0 : ovyl[mi] = 64
upd_shadow_27
upd_shadow_str
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 amt = tmp + ovxl[mi] : stp = stp + ovx[mi]
 if amt < tmp then stp = stp + 1
 tmp = amt
 ofx[mi] = tmp
 if stp = 0 then goto upd_shadow_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_shadow_y
 if blocked = 1 then goto upd_shadow_28
 ovx[mi] = 0 : ovxl[mi] = 0
 goto upd_shadow_y
upd_shadow_28
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_shadow_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 amt = tmp + ovyl[mi] : stp = stp + ovy[mi]
 if amt < tmp then stp = stp + 1
 tmp = amt
 ofy[mi] = tmp
 if stp = 0 then goto upd_shadow_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_shadow_d
 if blocked = 1 then goto upd_shadow_29
 ovy[mi] = 0 : ovyl[mi] = 0
 goto upd_shadow_d
upd_shadow_29
