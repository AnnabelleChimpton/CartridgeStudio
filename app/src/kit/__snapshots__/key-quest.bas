rule2_nj_2
rule2_ni
rule2_end

 rem rule 3: When Knight touches Locked door, only if Keys is 0: send the Knight back to start and play
 rem   Falling tone.
rule3
 if cnt_keys <> 0 then goto rule3_end
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule3_ni
 if oprot[oi] then goto rule3_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 3
 if otype[oj] <> T_DOOR then goto rule3_nj_3
 if oprot[oj] then goto rule3_nj_3
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 14, x2, y2, 16, 16) then gosub rule3_do
 if ruleexit then return
 if otype[oi] <> T_KNIGHT then goto rule3_ni
rule3_nj_3
rule3_ni
rule3_end

 rem rule 4: When Knight touches Gem: remove the Gem, add 20 points and play Blip.
rule4
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule4_ni
 if oprot[oi] then goto rule4_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 5
 if otype[oj] <> T_GEM then goto rule4_nj_4
 if oprot[oj] then goto rule4_nj_4
 x2 = ox[oj] : y2 = oy[oj]
