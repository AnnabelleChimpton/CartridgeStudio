 rem ---- timers: four slots a frame, so each slot counts down every tenth of a second ----
tick
 tick6 = tick6 + 1
 if tick6 >= 6 then tick6 = 0
 tk = tick6 * 4 : tend = tk + 4
tickloop
 if oprot[tk] then oprot[tk] = oprot[tk] - 1
ticknext
 tk = tk + 1
 if tk < tend then goto tickloop
 return

 rem ---- rules (generated from the project), in order ----
rules
 oddframe = frame & 1
 rem rule 1: When Knight touches Key: remove the Key, add 1 to Keys, add 50 points and play Rising tone.
rule1
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule1_ni
 if oprot[oi] then goto rule1_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 2
 if otype[oj] <> T_KEY then goto rule1_nj_1
 if oprot[oj] then goto rule1_nj_1
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 14, x2, y2, 8, 6) then gosub rule1_do
 if ruleexit then return
 if otype[oi] <> T_KNIGHT then goto rule1_ni
rule1_nj_1
rule1_ni
rule1_end

 rem rule 2: When Knight touches Locked door, only if Keys is at least 1: remove the Locked door, take 1
 rem   from Keys, add 100 points and play Chime.
rule2
 if cnt_keys < 1 then goto rule2_end
 oi = 0
 if otype[oi] <> T_KNIGHT then goto rule2_ni
 if oprot[oi] then goto rule2_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 3
 if otype[oj] <> T_DOOR then goto rule2_nj_2
 if oprot[oj] then goto rule2_nj_2
 x2 = ox[oj] : y2 = oy[oj]
