 ovy[mi] = 255 : ovyl[mi] = 0
 goto upd_knight_ctl
upd_knight_14
 if !pad1{1} then goto upd_knight_15
 ovy[mi] = 1 : ovyl[mi] = 0
 goto upd_knight_ctl
upd_knight_15
upd_knight_ctl
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 ofx[mi] = tmp
 if stp = 0 then goto upd_knight_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 8 : hgt = 14
 gosub trymovesized
 if blocked = 0 then goto upd_knight_y
 if blocked = 1 then goto upd_knight_16
 ovx[mi] = 0 : ovxl[mi] = 0
 goto upd_knight_y
upd_knight_16
 if stp >= 128 then goto upd_knight_17
 tmp = exitright[roomi]
 if tmp = EMPTY then goto upd_knight_18
 goroom = tmp + 1 : ox[mi] = 0
 goto upd_knight_y
upd_knight_17
 tmp = exitleft[roomi]
 if tmp = EMPTY then goto upd_knight_18
 goroom = tmp + 1 : ox[mi] = 152
 goto upd_knight_y
upd_knight_18
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_knight_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 ofy[mi] = tmp
 if stp = 0 then goto upd_knight_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 8 : hgt = 14
 gosub trymovesized
 if blocked = 0 then goto upd_knight_d
 if blocked = 1 then goto upd_knight_19
 ovy[mi] = 0 : ovyl[mi] = 0
 goto upd_knight_d
upd_knight_19
 if stp >= 128 then goto upd_knight_20
