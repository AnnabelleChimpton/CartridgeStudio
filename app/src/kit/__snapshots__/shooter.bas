 ds = oj : gosub kill_invader
 score0 = score0 + 10
 playsfx sfx_boom
 return

rule2_do
 ds = oi : gosub kill_bomb
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_3
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_3
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_4
 oprot[ak] = 15
tgt_4
 playsfx sfx_down
 return

rule3_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_6
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_6
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_7
 oprot[ak] = 15
tgt_7
 playsfx sfx_down
 gosub startroom : ruleexit = 1
 return

rule4_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_9
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_9
 ak = 0
 if otype[ak] <> T_BASKET then goto tgt_10
 oprot[ak] = 15
tgt_10
 gosub startroom : ruleexit = 1
 return

rule5_do
 playsfx sfx_up
 gosub startroom : ruleexit = 1
 return

rule6_do
 cs = 11
 if otype[cs] = EMPTY then goto make_12
 goto make_13
make_12
 ox[cs] = ox[oi] + 6
