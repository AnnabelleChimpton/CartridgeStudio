 rem Cat vs. Vacuums - generated by Cartridge Studio (game kit runtime 0.4.0)
 rem Do not edit; regenerate from the project.
 rem
 rem One runtime for every kit game (kit model v2). The project supplies kinds
 rem of thing built from movement parts, rooms, counters and rules. The
 rem generator compiles each kind's movement and drawing into its own loop
 rem over its own slots, with sizes and speeds written in, and each rule into
 rem straight-line checks. Positions are 8.8 fixed point: whole pixels in
 rem ox/oy, 1/256ths in ofx/ofy; velocities likewise (ovx/ovxl, ovy/ovyl).
 rem
 rem 7800basic 0.41 pitfalls (templates/README.md): never multiply by a
 rem const name, never pass a const as a plotsprite or boxcollision
 rem position, BCD consts for score math, characterset before plotvalue,
 rem and no variable may start with "switch".
 rem
 rem ---- memory map ----
 rem $2200 otype      24 bytes: kind of thing (255: empty)
 rem $2218 ox         24 bytes: x, whole pixels
 rem $2230 oy         24 bytes: y, whole pixels
 rem $2248 ofx        24 bytes: x, 1/256ths
 rem $2260 ofy        24 bytes: y, 1/256ths
 rem $2278 ovx        24 bytes: vx, whole pixels (signed)
 rem $2290 ovxl       24 bytes: vx, 1/256ths
 rem $22A8 ovy        24 bytes: vy, whole pixels (signed)
 rem $22C0 ovyl       24 bytes: vy, 1/256ths
 rem $22D8 osx        24 bytes: start x
 rem $22F0 osy        24 bytes: start y
 rem $2308 oprot      24 bytes: protected for this many tenths
 rem $2320 ev7         1 bytes: countdown for an every-N rule

 displaymode 160A
 set zoneheight 8
 set romsize 32k
 set screenheight 192
 rem console Pause is 7800basic's own: drawscreen holds the game while paused;
 rem this also keeps the sound effects quiet until it's unpaused
 set pausesilence on

 autodim init var0 var99
 autodim byte gamestate
 autodim byte statesecs
 autodim byte stateframes
 autodim byte demo
 autodim byte tmp
 autodim byte tmp2
 autodim byte tmp3
 autodim byte vt
 autodim byte oddframe
 autodim byte resetheld
 rem it, the other, and the thing moving: oi, oj, mi (ei: "it" in a rule run by another rule's action)
 autodim byte oi
 autodim byte oj
 autodim byte mi
 autodim byte ms
 autodim byte ei
 rem loops: ak/ek every-X targets, cs creating, ck counting, rc random, rk rooms, tk placing and ticking
 autodim byte ak
 autodim byte ek
 autodim byte cs
 autodim byte ck
 autodim byte rc
 autodim byte rk
 autodim byte sk
 autodim byte ds
 autodim byte ps
 autodim byte sl
 autodim byte ot
 autodim byte nx
 autodim byte ny
 autodim byte wid
 autodim byte hgt
 autodim byte px
 autodim byte py
 autodim byte cell
 autodim byte tc
 autodim byte stp
 autodim byte blocked
 autodim byte offcheck
 autodim byte amt
 autodim byte sp
 autodim byte gg
 autodim byte sdy
 autodim byte fr
 autodim byte x1
 autodim byte y1
 autodim byte x2
 autodim byte y2
 autodim byte frame
 autodim byte seconds
 autodim byte secondtick
 autodim byte loopslo
 autodim byte loopshi
 autodim byte latches
 autodim byte latches2
 rem counters the behaviour tests watch by name (aliases of the counters "lives" and "level")
 autodim byte lives
 autodim byte levelnum
 autodim byte tk
 autodim byte tend
 autodim byte tick6
 autodim byte pad1
 autodim byte padprev
 autodim byte padpressed
 autodim byte padreleased
 autodim byte ruleexit
 autodim byte msgs
 autodim byte msgnow
 autodim byte roomi
 autodim byte roomnum
 autodim byte drawnroom
 autodim byte goroom
 autodim byte keepplayers
 autodim byte nfrom
 autodim byte ntype
 autodim byte nlo
 autodim byte nhi
 autodim byte nbest
 autodim byte nbestd
 autodim byte nn
 autodim byte demoi
 autodim byte demon
 autodim byte hud0
 autodim byte hud1
 autodim byte endbcd0

 const STATE_TITLE = 0
 const STATE_PLAY = 1
 const STATE_WON = 2
 const STATE_LOST = 3
 const STATE_ATTRACT = 4
 const EMPTY = 255
 const ROOMTOP = 16
 const T_BASKET = 0
 const T_INVADER = 1
 const T_SHOT = 2
 const T_BOMB = 3
 const TILE_WALL = 1
 const TILE_HAZARD = 2
 const TILE_GOAL = 3
 const ROOMS = 1

 rem per-thing tables: 24 slots each (see the memory map)
 dim otype = $2200
 dim ox = $2218
 dim oy = $2230
 dim ofx = $2248
 dim ofy = $2260
 dim ovx = $2278
 dim ovxl = $2290
 dim ovy = $22A8
 dim ovyl = $22C0
 dim osx = $22D8
 dim osy = $22F0
 dim oprot = $2308
 dim ev7 = $2320

 rem Laundry basket
 incgraphic spr_basket.png 160A 0 1 2 3
 rem Vacuum
 incgraphic spr_invader.png 160A 0 1 2 3
 rem Vacuum frame 2
 incgraphic spr_invader_2.png 160A 0 1 2 3
 rem Sock
 incgraphic spr_shot.png 160A 0 1 2 3
 rem Dust bomb
 incgraphic spr_bomb.png 160A 0 1 2 3
 incgraphic font.png 160A 0 1 2 3
 characterset font
 alphachars '0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ.!?-:#~*'

 rem palette basket
 P0C1 = $28 : P0C2 = $22 : P0C3 = $3A
 rem palette enemy
 P1C1 = $96 : P1C2 = $42 : P1C3 = $90
 rem palette shot
 P2C1 = $0F : P2C2 = $1C : P2C3 = $1C
 rem palette bomb
 P3C1 = $46 : P3C2 = $46 : P3C3 = $46
 rem palette text
 P4C1 = $0F : P4C2 = $0F : P4C3 = $0F
 BACKGRND = $00

 roomi = 0 : drawnroom = 255
 latches = 0 : latches2 = 0
 lives = 3
 rem audio: a later title tune and jingles start here (kit/audio.ts reserves this spot)
 rem ---- user_init: your code, once at power-on ----
 rem (empty)

 gamestate = STATE_TITLE
 gosub startroom

main
 restorescreen
 frame = frame + 1
 rem count main-loop passes (frame-rate checks read this)
 loopslo = loopslo + 1
 if loopslo = 0 then loopshi = loopshi + 1
 rem audio: the per-frame music call goes here (reserved for kit/audio.ts)
 rem console Reset goes back to the title screen, once per press; Select is reserved
 if !switchreset then resetheld = 0
 if switchreset && resetheld = 0 then resetheld = 1 : gosub totitle
 rem joystick 1 as bits: 1 up, 2 down, 4 left, 8 right, 16 fire
 pad1 = 0
 if joy0up then pad1 = pad1 | 1
 if joy0down then pad1 = pad1 | 2
 if joy0left then pad1 = pad1 | 4
 if joy0right then pad1 = pad1 | 8
 if joy0fire then pad1 = pad1 | 16

 rem the demo plays recorded input; anything real ends it
 if gamestate <> STATE_ATTRACT then goto notdemo
 if pad1 then gosub totitle : goto notdemo
 gosub demoread
notdemo

 tmp = padprev ^ 255 : padpressed = pad1 & tmp
 tmp = pad1 ^ 255 : padreleased = padprev & tmp
 padprev = pad1
 on gamestate goto st_title st_play st_end st_end st_play

st_title

 gosub statetick
 if statesecs >= 20 then gosub startdemo : goto draw

 if padpressed{4} then gosub newgame
 goto draw

st_end
 if demo then gosub totitle : goto draw

 if padpressed{4} then gosub totitle
 goto draw

st_play
 ruleexit = 0
 secondtick = secondtick + 1
 if secondtick >= 60 then secondtick = 0 : seconds = seconds + 1

 gosub tick
 if ruleexit then goto draw

 gosub moveall

 rem ---- user_frame: your code, once a frame, after movement and before the rules ----
 rem (empty)
 if ruleexit then goto draw
 gosub rules
 if ruleexit then goto draw
 rem nothing leaves the screen and waits for a rule
 goto draw

draw
 plotvalue font 4 score0 6 4 0
 hud1 = converttobcd(lives)
 plotvalue font 4 hud1 2 152 0
 rem Laundry basket
 oi = 0
 if otype[oi] <> T_BASKET then goto drw_basket_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_basket_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_basket 0 px py
drw_basket_next
 rem Vacuum
 for oi = 1 to 10
 if otype[oi] <> T_INVADER then goto drw_invader_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_invader_next
 if oy[oi] >= 192 then goto drw_invader_next
 px = ox[oi] : py = oy[oi]
 fr = 0
 tmp = frame & 16
 if tmp then fr = fr + 1
 plotsprite4 spr_invader 1 px py fr
drw_invader_next
 next
 rem Sock
 oi = 11
 if otype[oi] <> T_SHOT then goto drw_shot_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_shot_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_shot 2 px py
drw_shot_next
 rem Dust bomb
 oi = 12
 if otype[oi] <> T_BOMB then goto drw_bomb_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_bomb_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_bomb 3 px py
drw_bomb_next
 rem ---- user_draw: your code, after the things are drawn ----
 rem (empty)
 if gamestate = STATE_TITLE then gosub drawtitle
 if gamestate = STATE_WON then gosub drawwon
 if gamestate = STATE_LOST then gosub drawlost

 if gamestate = STATE_ATTRACT then gosub drawdemo

 drawscreen
 goto main

 rem ---- game flow ----
newgame
 score0 = 0
 latches = 0 : latches2 = 0
 demo = 0 : roomi = 0
 lives = 3

 gamestate = STATE_PLAY
 gosub startroom
 return

totitle
 gamestate = STATE_TITLE : statesecs = 0 : stateframes = 0 : demo = 0
 roomi = 0
 gosub startroom
 return

statetick
 stateframes = stateframes + 1
 if stateframes >= 60 then stateframes = 0 : statesecs = statesecs + 1
 return

startdemo
 gosub newgame
 gamestate = STATE_ATTRACT : demo = 1
 demoi = 0 : demon = demoinput[1]
 return

demoread
 if demon = 0 then gosub totitle : return
 pad1 = demoinput[demoi]
 demon = demon - 1
 if demon then return
 demoi = demoi + 2
 tmp = demoi + 1 : demon = demoinput[tmp]
 return

startroom
 rem the room's walls are drawn once and saved; starting the same room again (a new game,
 rem the title, "start the room again") keeps them, so a restart fits in its frame
 if drawnroom = roomi then goto srdrawn
 clearscreen
 plotmap roommap 4 0 2 20 22 0 0 40
 plotmap roommap 4 80 2 20 22 20 0 40
 savescreen
 drawnroom = roomi
srdrawn
 roomnum = roomi + 1
 for oi = 0 to 23 : otype[oi] = EMPTY : next
 tk = roomfirst[roomi] : tend = roomend[roomi]
 if tk = tend then goto srplaced
srplace
 sl = spslot[tk]
 if otype[sl] <> EMPTY then goto srnext
 ot = sptype[tk] : otype[sl] = ot
 ox[sl] = spx[tk] : oy[sl] = spy[tk]
 osx[sl] = ox[sl] : osy[sl] = oy[sl]
 ofx[sl] = 0 : ofy[sl] = 0
 ovx[sl] = typevx[ot] : ovxl[sl] = typevxl[ot]
 ovy[sl] = typevy[ot] : ovyl[sl] = typevyl[ot]
 oprot[sl] = 0
srnext
 tk = tk + 1
 if tk < tend then goto srplace
srplaced
 rem nothing resets per room
 seconds = 0 : secondtick = 0 : msgs = 0
 if gamestate = STATE_TITLE then goto startroomdone
 rem audio: a room's music starts here (reserved for kit/audio.ts)
 rem no room start rules
startroomdone
 rem ---- user_startroom: your code, at the end of every room start ----
 rem (empty)
 return

 rem ---- movement: one compiled loop per kind of thing ----
moveall
 rem ---- Laundry basket: joystick 1 (lr, direct), velocity, walls: slide, edges: stop ----
 mi = 0
 if otype[mi] <> T_BASKET then goto upd_basket_next
 ovx[mi] = 0 : ovxl[mi] = 0
 if !pad1{2} then goto upd_basket_24
 ovx[mi] = 254 : ovxl[mi] = 0
upd_basket_24
 if !pad1{3} then goto upd_basket_25
 ovx[mi] = 2 : ovxl[mi] = 0
upd_basket_25
upd_basket_ctl
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 ofx[mi] = tmp
 if stp = 0 then goto upd_basket_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 16 : hgt = 16
 gosub trymoveedge
 if blocked = 0 then goto upd_basket_y
 if blocked = 1 then goto upd_basket_26
 ovx[mi] = 0 : ovxl[mi] = 0
 goto upd_basket_y
upd_basket_26
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_basket_y
upd_basket_d
upd_basket_next
 rem ---- Vacuum: velocity, walls: through, edges: pass ----
 for mi = 1 to 10
 if otype[mi] <> T_INVADER then goto upd_invader_next
 offcheck = 0
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 ofx[mi] = tmp
 if stp = 0 then goto upd_invader_y
 ox[mi] = ox[mi] + stp
 if ox[mi] >= 160 then offcheck = 1
upd_invader_y
upd_invader_d
 if offcheck = 0 then goto upd_invader_next
 wid = 12 : hgt = 8
 gosub offscreen
 if tmp then ds = mi : gosub kill_invader
upd_invader_next
 next
 rem ---- Sock: velocity, walls: destroy, edges: destroy ----
 mi = 11
 if otype[mi] <> T_SHOT then goto upd_shot_next
upd_shot_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 ofy[mi] = tmp
 if stp = 0 then goto upd_shot_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 4 : hgt = 6
 gosub trymoveedge
 if blocked = 0 then goto upd_shot_d
 if blocked = 1 then goto upd_shot_27
 ds = mi : gosub kill_shot
 goto upd_shot_next
upd_shot_27
 ds = mi : gosub kill_shot
 goto upd_shot_next
upd_shot_d
upd_shot_next
 rem ---- Dust bomb: velocity, walls: destroy, edges: destroy ----
 mi = 12
 if otype[mi] <> T_BOMB then goto upd_bomb_next
upd_bomb_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 ofy[mi] = tmp
 if stp = 0 then goto upd_bomb_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 4 : hgt = 4
 gosub trymoveedge
 if blocked = 0 then goto upd_bomb_d
 if blocked = 1 then goto upd_bomb_28
 ds = mi : gosub kill_bomb
 goto upd_bomb_next
upd_bomb_28
 ds = mi : gosub kill_bomb
 goto upd_bomb_next
upd_bomb_d
upd_bomb_next
 return

 rem ---- movement helpers ----
 rem trymovesized: move slot mi (wid x hgt) to (nx, ny) unless something is in the way;
 rem blocked = 1 for a screen edge, 2 for a wall. trymoveedge doesn't check walls.
trymoveedge
 blocked = 1
 if nx > 159 then return
 tmp = nx + wid - 1
 if tmp > 159 then return
 if ny < ROOMTOP then return
 if ny > 191 then return
 tmp = ny + hgt - 1
 if tmp > 191 then return
 blocked = 0
 ox[mi] = nx : oy[mi] = ny
 return

 rem offscreen: tmp = 1 when slot mi (wid x hgt) is wholly off the screen
offscreen
 tmp = 1
 if ox[mi] < 160 then goto offy
 tmp2 = ox[mi] + wid
 if tmp2 = 0 then return
 if tmp2 >= 160 then return
offy
 if oy[mi] >= 192 then return
 tmp2 = oy[mi] + hgt
 if tmp2 <= ROOMTOP then return
 tmp = 0
 return

 rem nearest: nbest = the slot of the nearest thing of kind ntype (slots nlo-nhi) to slot nfrom,
 rem by |dx| + |dy|, or EMPTY when there's none
nearest
 nbest = EMPTY : nbestd = 255
 px = ox[nfrom] : py = oy[nfrom]
 for nn = nlo to nhi
 if otype[nn] <> ntype then goto nearnext
 if nn = nfrom then goto nearnext
 if ox[nn] >= px then tmp = ox[nn] - px else tmp = px - ox[nn]
 if oy[nn] >= py then tmp2 = oy[nn] - py else tmp2 = py - oy[nn]
 tmp = tmp + tmp2
 if tmp < tmp2 then tmp = 254
 if tmp < nbestd then nbestd = tmp : nbest = nn
nearnext
 next
 return

 rem ---- removing things (each runs its kind's "destroyed" rules) ----
kill_basket
 rem remove a Laundry basket
 otype[ds] = EMPTY
 return

kill_invader
 rem remove a Vacuum
 otype[ds] = EMPTY
 return

kill_shot
 rem remove a Sock
 otype[ds] = EMPTY
 return

kill_bomb
 rem remove a Dust bomb
 otype[ds] = EMPTY
 return

 rem ---- timers: four slots a frame, so each slot counts down every tenth of a second ----
tick
 tick6 = tick6 + 1
 if tick6 >= 6 then tick6 = 0
 tk = tick6 * 4 : tend = tk + 4
tickloop
 if oprot[tk] then oprot[tk] = oprot[tk] - 1
ticknext
 tk = tk + 1
 if tk < tend then goto tickloop
 return

 rem ---- rules (generated from the project), in order ----
rules
 oddframe = frame & 1
 rem rule 1: When Sock touches Vacuum: remove the Sock, remove the Vacuum, add 10 points and play Boom.
rule1
 oi = 11
 if otype[oi] <> T_SHOT then goto rule1_ni
 if oprot[oi] then goto rule1_ni
 x1 = ox[oi] : y1 = oy[oi]
 for oj = 1 to 10
 if otype[oj] <> T_INVADER then goto rule1_nj_1
 if oprot[oj] then goto rule1_nj_1
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 4, 6, x2, y2, 12, 8) then gosub rule1_do
 if ruleexit then return
 if otype[oi] <> T_SHOT then goto rule1_ni
rule1_nj_1
 next
rule1_ni
rule1_end

 rem rule 2: When Dust bomb touches Laundry basket: remove the Dust bomb, take 1 from Lives, send every
 rem   Laundry basket back to start, protect every Laundry basket for 1.5 seconds and play Falling tone.
rule2
 oi = 12
 if otype[oi] <> T_BOMB then goto rule2_ni
 if oprot[oi] then goto rule2_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 0
 if otype[oj] <> T_BASKET then goto rule2_nj_2
 if oprot[oj] then goto rule2_nj_2
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 4, 4, x2, y2, 16, 16) then gosub rule2_do
 if ruleexit then return
 if otype[oi] <> T_BOMB then goto rule2_ni
rule2_nj_2
rule2_ni
rule2_end

 rem rule 3: When Vacuum touches Laundry basket: take 1 from Lives, send every Laundry basket back to
 rem   start, protect every Laundry basket for 1.5 seconds, play Falling tone and start the room again.
rule3
 oj = 0
 if otype[oj] <> T_BASKET then goto rule3_ni
 if oprot[oj] then goto rule3_ni
 x1 = ox[oj] : y1 = oy[oj]
 for oi = 1 to 10
 if otype[oi] <> T_INVADER then goto rule3_nj_5
 if oprot[oi] then goto rule3_nj_5
 x2 = ox[oi] : y2 = oy[oi]
 if boxcollision(x1, y1, 16, 16, x2, y2, 12, 8) then gosub rule3_do
 if ruleexit then return
 if otype[oj] <> T_BASKET then goto rule3_ni
rule3_nj_5
 next
rule3_ni
rule3_end

 rem rule 4: While a Vacuum reaches the bottom edge: take 1 from Lives, send every Laundry basket back to
 rem   start, protect every Laundry basket for 1.5 seconds and start the room again.
rule4
 for oi = 1 to 10
 if otype[oi] <> T_INVADER then goto rule4_next
 if oy[oi] >= 240 then goto rule4_e_8
 tmp = oy[oi] + 8
 if tmp >= 190 then goto rule4_hit
rule4_e_8
 goto rule4_next
rule4_hit
 gosub rule4_do
 if ruleexit then return
rule4_next
 next
rule4_end

 rem rule 5: When the number of Vacuums is 0: play Rising tone and start the room again.
rule5
 if oddframe = 0 then goto rule5_end
 tmp2 = 0
 for ck = 1 to 10
 if otype[ck] = T_INVADER then tmp2 = tmp2 + 1
 next
 if tmp2 <> 0 then goto rule5_off
 if latches{0} then goto rule5_end
 latches{0} = 1
 gosub rule5_do
 if ruleexit then return
 goto rule5_end
rule5_off
 latches{0} = 0
rule5_end

 rem rule 6: When button 1 is pressed, only if the number of Socks is 0: create a Sock above the Laundry
 rem   basket and play Zap.
rule6
 if !padpressed{4} then goto rule6_end
 tmp2 = 0
 if otype[11] = T_SHOT then tmp2 = 1
 if tmp2 <> 0 then goto rule6_end
 oi = 0
 if otype[oi] <> T_BASKET then goto rule6_p_11
 gosub rule6_do
 if ruleexit then return
rule6_p_11
rule6_end

 rem rule 7: Every frame, only if a random number up to 255 is less than 50 and the number of Dust bombs
 rem   is 0: create a Dust bomb below a random Vacuum.
rule7
 tmp2 = rand
 if tmp2 >= 50 then goto rule7_end
 tmp2 = 0
 if otype[12] = T_BOMB then tmp2 = 1
 if tmp2 <> 0 then goto rule7_end
 gosub rule7_do
 if ruleexit then return
rule7_end

 rem rule 8: When any Vacuum reaches the left or right edge: set every Vacuum's speed across to its speed
 rem   across, reversed and add 8 to every Vacuum's y.
rule8
 for oi = 1 to 10
 if otype[oi] <> T_INVADER then goto rule8_next
 if ox[oi] < 2 then goto rule8_hit
 if ox[oi] >= 208 then goto rule8_hit
 if ox[oi] >= 208 then goto rule8_e_21
 tmp = ox[oi] + 12
 if tmp >= 158 then goto rule8_hit
rule8_e_21
 goto rule8_next
rule8_hit
 if latches{1} then goto rule8_end
 latches{1} = 1
 gosub rule8_do
 if ruleexit then return
 goto rule8_end
rule8_next
 next
 latches{1} = 0
rule8_end

 rem rule 9: When Lives is 0: lose the game.
rule9
 if oddframe = 0 then goto rule9_end
 if lives <> 0 then goto rule9_off
 if latches{2} then goto rule9_end
 latches{2} = 1
 gosub rule9_do
 if ruleexit then return
 goto rule9_end
rule9_off
 latches{2} = 0
rule9_end

 return

