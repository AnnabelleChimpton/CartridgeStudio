 rem (empty)
 if gamestate = STATE_TITLE then gosub drawtitle
 if gamestate = STATE_WON then gosub drawwon
 if gamestate = STATE_LOST then gosub drawlost

 drawscreen
 goto main

 rem ---- game flow ----
newgame
 score0 = 0
 latches = 0 : latches2 = 0
 demo = 0 : roomi = 0
 lives = 3
 levelnum = 1
 cnt_pace = 0
 cnt_combo = 0

 gamestate = STATE_PLAY
 gosub startroom
 return

totitle
 gamestate = STATE_TITLE : statesecs = 0 : stateframes = 0 : demo = 0
 roomi = 0
 gosub startroom
 return

statetick
 stateframes = stateframes + 1
 if stateframes >= 60 then stateframes = 0 : statesecs = statesecs + 1
 return

startroom
 rem the room's walls are drawn once and saved; starting the same room again (a new game,
 rem the title, "start the room again") keeps them, so a restart fits in its frame
 if drawnroom = roomi then goto srdrawn
 clearscreen
 plotmap roommap 3 0 2 20 22 0 0 40
 plotmap roommap 3 80 2 20 22 20 0 40
 savescreen
 drawnroom = roomi
srdrawn
 roomnum = roomi + 1
 for oi = 0 to 23 : otype[oi] = EMPTY : next
 tk = roomfirst[roomi] : tend = roomend[roomi]
 if tk = tend then goto srplaced
srplace
 sl = spslot[tk]
 if otype[sl] <> EMPTY then goto srnext
 ot = sptype[tk] : otype[sl] = ot
 ox[sl] = spx[tk] : oy[sl] = spy[tk]
 osx[sl] = ox[sl] : osy[sl] = oy[sl]
 ofx[sl] = 0 : ofy[sl] = 0
 ovx[sl] = typevx[ot] : ovxl[sl] = typevxl[ot]
 ovy[sl] = typevy[ot] : ovyl[sl] = typevyl[ot]
 otimer[sl] = 0
 oback[sl] = EMPTY
 oprot[sl] = 0
srnext
 tk = tk + 1
 if tk < tend then goto srplace
srplaced
 ev8 = 15
 seconds = 0 : secondtick = 0 : msgs = 0
 if gamestate = STATE_TITLE then goto startroomdone
