 const STATE_TITLE = 0
 const STATE_PLAY = 1
 const STATE_WON = 2
 const STATE_LOST = 3
 const STATE_ATTRACT = 4
 const EMPTY = 255
 const ROOMTOP = 16
 const T_CAT = 0
 const T_GHOST = 1
 const T_SCARED = 2
 const T_FAST_GHOST = 3
 const T_YARN = 4
 const T_CATNIP = 5
 const TILE_WALL = 1
 const TILE_HAZARD = 2
 const TILE_GOAL = 3
