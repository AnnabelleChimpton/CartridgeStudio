 rem per-thing tables: 24 slots each (see the memory map)
 dim otype = $2200
 dim ox = $2218
 dim oy = $2230
 dim ofx = $2248
 dim ofy = $2260
 dim ovx = $2278
 dim ovxl = $2290
 dim ovy = $22A8
 dim ovyl = $22C0
