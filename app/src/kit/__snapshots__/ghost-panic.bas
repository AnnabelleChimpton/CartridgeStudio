 rem ---- user_init: your code, once at power-on ----
 rem (empty)

 gamestate = STATE_TITLE
 gosub startroom

main
 restorescreen
 frame = frame + 1
 rem count main-loop passes (frame-rate checks read this)
 loopslo = loopslo + 1
 if loopslo = 0 then loopshi = loopshi + 1
 rem audio: the per-frame music call goes here (reserved for kit/audio.ts)
 rem console Reset goes back to the title screen, once per press; Select is reserved
 if !switchreset then resetheld = 0
 if switchreset && resetheld = 0 then resetheld = 1 : gosub totitle
 rem joystick 1 as bits: 1 up, 2 down, 4 left, 8 right, 16 fire
 pad1 = 0
 if joy0up then pad1 = pad1 | 1
 if joy0down then pad1 = pad1 | 2
 if joy0left then pad1 = pad1 | 4
 if joy0right then pad1 = pad1 | 8
 if joy0fire then pad1 = pad1 | 16

 tmp = padprev ^ 255 : padpressed = pad1 & tmp
 tmp = pad1 ^ 255 : padreleased = padprev & tmp
 padprev = pad1
 on gamestate goto st_title st_play st_end st_end st_play

st_title

 if padpressed{4} then gosub newgame
 goto draw

st_end
 if demo then gosub totitle : goto draw

 if padpressed{4} then gosub totitle
 goto draw

st_play
 ruleexit = 0
 secondtick = secondtick + 1
 if secondtick >= 60 then secondtick = 0 : seconds = seconds + 1

 gosub tick
 if ruleexit then goto draw

 gosub moveall

 rem ---- user_frame: your code, once a frame, after movement and before the rules ----
 rem (empty)
 if ruleexit then goto draw
 gosub rules
 if ruleexit then goto draw
 rem nothing leaves the screen and waits for a rule
 goto draw

draw
 plotvalue font 4 score0 6 4 0
 hud1 = converttobcd(lives)
 plotvalue font 4 hud1 2 152 0
 rem Cat
 oi = 0
 if otype[oi] <> T_CAT then goto drw_cat_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_cat_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_cat 0 px py
drw_cat_next
 rem Dust ghost
 for oi = 1 to 2
 if otype[oi] <> T_GHOST then goto drw_ghost_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_ghost_next
 px = ox[oi] : py = oy[oi]
 fr = 0
 tmp = frame & 16
 if tmp then fr = fr + 1
 plotsprite4 spr_ghost 1 px py fr
drw_ghost_next
 next
 rem Scared ghost
 for oi = 1 to 2
 if otype[oi] <> T_SCARED then goto drw_scared_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_scared_next
 px = ox[oi] : py = oy[oi]
