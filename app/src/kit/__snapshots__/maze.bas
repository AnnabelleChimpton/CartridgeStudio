 rem Yarn Hunt - generated by Cartridge Studio (game kit runtime 0.4.0)
 rem Do not edit; regenerate from the project.
 rem
 rem One runtime for every kit game. The project supplies kinds of thing
 rem built from movement parts, rooms, counters and rules. The generator
 rem compiles each kind's movement and drawing into its own loop over its
 rem own slots, with sizes and speeds written in, and each rule into
 rem straight-line checks. Positions are 8.8 fixed point: whole pixels in
 rem ox/oy, 1/256ths in ofx/ofy. Velocity is signed 8.8 in pixels per
 rem frame: whole pixels in ovx/ovy, 1/256ths in ovxl/ovyl (the editor's
 rem sixteenths of a pixel, times 16).
 rem
 rem 7800basic 0.41 pitfalls (PITFALLS.txt in the exported folder): never
 rem multiply by a const name, never pass a const as a plotsprite or
 rem boxcollision position, BCD consts for score math, characterset before
 rem plotvalue, and no variable may start with "switch".
 rem
 rem ---- memory map ----
 rem $2200 otype      24 bytes: kind of thing (255: empty)
 rem $2218 ox         24 bytes: x, whole pixels
 rem $2230 oy         24 bytes: y, whole pixels
 rem $2248 ofx        24 bytes: x, 1/256ths
 rem $2260 ofy        24 bytes: y, 1/256ths
 rem $2278 ovx        24 bytes: vx, whole pixels (signed)
 rem $2290 ovxl       24 bytes: vx, 1/256ths
 rem $22A8 ovy        24 bytes: vy, whole pixels (signed)
 rem $22C0 ovyl       24 bytes: vy, 1/256ths
 rem $22D8 osx        24 bytes: start x
 rem $22F0 osy        24 bytes: start y
 rem $2308 oprot      24 bytes: protected for this many tenths

 displaymode 160A
 set zoneheight 8
 set romsize 32k
 set screenheight 192
 rem console Pause is 7800basic's own: drawscreen holds the game while paused;
 rem this also keeps the sound effects quiet until it's unpaused
 set pausesilence on

 autodim init var0 var99
 autodim byte gamestate
 autodim byte statesecs
 autodim byte stateframes
 autodim byte demo
 autodim byte tmp
 autodim byte tmp2
 autodim byte tmp3
 autodim byte vt
 autodim byte oddframe
 autodim byte resetheld
 rem it, the other, and the thing moving: oi, oj, mi (ei: "it" in a rule run by another rule's action)
 autodim byte oi
 autodim byte oj
 autodim byte mi
 autodim byte ms
 autodim byte ei
 rem loops: ak/ek every-X targets, cs creating, ck counting, rc random, rk rooms, tk placing and ticking
 autodim byte ak
 autodim byte ek
 autodim byte cs
 autodim byte ck
 autodim byte rc
 autodim byte rk
 autodim byte sk
 autodim byte ds
 autodim byte ps
 autodim byte sl
 autodim byte ot
 autodim byte nx
 autodim byte ny
 autodim byte wid
 autodim byte hgt
 autodim byte px
 autodim byte py
 autodim byte cell
 autodim byte tc
 autodim byte stp
 autodim byte blocked
 autodim byte offcheck
 autodim byte amt
 autodim byte sp
 autodim byte gg
 autodim byte sdy
 autodim byte fr
 autodim byte x1
 autodim byte y1
 autodim byte x2
 autodim byte y2
 autodim byte frame
 autodim byte seconds
 autodim byte secondtick
 autodim byte loopslo
 autodim byte loopshi
 autodim byte latches
 autodim byte latches2
 rem counters the behaviour tests watch by name (aliases of the counters "lives" and "level")
 autodim byte lives
 autodim byte levelnum
 autodim byte tk
 autodim byte tend
 autodim byte tick6
 autodim byte pad1
 autodim byte padprev
 autodim byte padpressed
 autodim byte padreleased
 autodim byte ruleexit
 autodim byte msgs
 autodim byte msgnow
 autodim byte roomi
 autodim byte roomnum
 autodim byte drawnroom
 autodim byte goroom
 autodim byte keepplayers
 autodim byte nfrom
 autodim byte ntype
 autodim byte nlo
 autodim byte nhi
 autodim byte nbest
 autodim byte nbestd
 autodim byte nn
 autodim byte demoi
 autodim byte demon
 autodim byte hud0
 autodim byte hud1
 autodim byte endbcd0

 const STATE_TITLE = 0
 const STATE_PLAY = 1
 const STATE_WON = 2
 const STATE_LOST = 3
 const STATE_ATTRACT = 4
 const EMPTY = 255
 const ROOMTOP = 16
 const T_CAT = 0
 const T_GHOST = 1
 const T_YARN = 2
 const T_BAT = 3
 const TILE_WALL = 1
 const TILE_HAZARD = 2
 const TILE_GOAL = 3
 const ROOMS = 1

 rem per-thing tables: 24 slots each (see the memory map)
 dim otype = $2200
 dim ox = $2218
 dim oy = $2230
 dim ofx = $2248
 dim ofy = $2260
 dim ovx = $2278
 dim ovxl = $2290
 dim ovy = $22A8
 dim ovyl = $22C0
 dim osx = $22D8
 dim osy = $22F0
 dim oprot = $2308

 rem Cat
 incgraphic spr_cat.png 160A 0 1 2 3
 rem Dust ghost
 incgraphic spr_ghost.png 160A 0 1 2 3
 rem Dust ghost frame 2
 incgraphic spr_ghost_2.png 160A 0 1 2 3
 rem Yarn ball
 incgraphic spr_yarn.png 160A 0 1 2 3
 rem Bat
 incgraphic spr_bat.png 160A 0 1 2 3
 rem Bat frame 2
 incgraphic spr_bat_2.png 160A 0 1 2 3
 incgraphic font.png 160A 0 1 2 3
 characterset font
 alphachars '0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ.!?-:#~*'

 rem P0: Cat
 P0C1 = $1C : P0C2 = $02 : P0C3 = $46
 rem P1: Dust ghost
 P1C1 = $56 : P1C2 = $0F : P1C3 = $02
 rem P2: Yarn ball
 P2C1 = $1E : P2C2 = $2A : P2C3 = $00
 rem P3: walls
 P3C1 = $84 : P3C2 = $82 : P3C3 = $00
 rem P4: text
 P4C1 = $0F : P4C2 = $0F : P4C3 = $0F
 rem P5: Bat
 P5C1 = $06 : P5C2 = $46 : P5C3 = $00
 BACKGRND = $00

 roomi = 0 : drawnroom = 255
 latches = 0 : latches2 = 0
 lives = 3
 rem audio: a later title tune and jingles start here (kit/audio.ts reserves this spot)
 rem ---- user_init: your code, once at power-on ----
 rem (empty)

 gamestate = STATE_TITLE
 gosub startroom

main
 restorescreen
 frame = frame + 1
 rem count main-loop passes (frame-rate checks read this)
 loopslo = loopslo + 1
 if loopslo = 0 then loopshi = loopshi + 1
 rem audio: the per-frame music call goes here (reserved for kit/audio.ts)
 rem console Reset goes back to the title screen, once per press; Select is reserved
 if !switchreset then resetheld = 0
 if switchreset && resetheld = 0 then resetheld = 1 : gosub totitle
 rem joystick 1 as bits: 1 up, 2 down, 4 left, 8 right, 16 fire
 pad1 = 0
 if joy0up then pad1 = pad1 | 1
 if joy0down then pad1 = pad1 | 2
 if joy0left then pad1 = pad1 | 4
 if joy0right then pad1 = pad1 | 8
 if joy0fire then pad1 = pad1 | 16

 rem the demo plays recorded input; anything real ends it
 if gamestate <> STATE_ATTRACT then goto notdemo
 if pad1 then gosub totitle : goto notdemo
 gosub demoread
notdemo

 tmp = padprev ^ 255 : padpressed = pad1 & tmp
 tmp = pad1 ^ 255 : padreleased = padprev & tmp
 padprev = pad1
 on gamestate goto st_title st_play st_end st_end st_play

st_title

 gosub statetick
 if statesecs >= 20 then gosub startdemo : goto draw

 if padpressed{4} then gosub newgame
 goto draw

st_end
 if demo then gosub totitle : goto draw

 if padpressed{4} then gosub totitle
 goto draw

st_play
 ruleexit = 0
 secondtick = secondtick + 1
 if secondtick >= 60 then secondtick = 0 : seconds = seconds + 1

 gosub tick
 if ruleexit then goto draw

 gosub moveall

 rem ---- user_frame: your code, once a frame, after movement and before the rules ----
 rem (empty)
 if ruleexit then goto draw
 gosub rules
 if ruleexit then goto draw
 rem nothing leaves the screen and waits for a rule
 goto draw

draw
 plotvalue font 4 score0 6 4 0
 hud1 = converttobcd(lives)
 plotvalue font 4 hud1 2 152 0
 rem Cat
 oi = 0
 if otype[oi] <> T_CAT then goto drw_cat_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_cat_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_cat 0 px py
drw_cat_next
 rem Dust ghost
 for oi = 1 to 2
 if otype[oi] <> T_GHOST then goto drw_ghost_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_ghost_next
 px = ox[oi] : py = oy[oi]
 fr = 0
 tmp = frame & 16
 if tmp then fr = fr + 1
 plotsprite4 spr_ghost 1 px py fr
drw_ghost_next
 next
 rem Yarn ball
 for oi = 3 to 13
 if otype[oi] <> T_YARN then goto drw_yarn_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_yarn_next
 px = ox[oi] : py = oy[oi]
 plotsprite4 spr_yarn 2 px py
drw_yarn_next
 next
 rem Bat
 oi = 14
 if otype[oi] <> T_BAT then goto drw_bat_next
 if oprot[oi] then tmp = frame & 16 else tmp = 0
 if tmp then goto drw_bat_next
 px = ox[oi] : py = oy[oi]
 fr = 0
 tmp = frame & 16
 if tmp then fr = fr + 1
 plotsprite4 spr_bat 5 px py fr
drw_bat_next
 rem ---- user_draw: your code, after the things are drawn ----
 rem (empty)
 if gamestate = STATE_TITLE then gosub drawtitle
 if gamestate = STATE_WON then gosub drawwon
 if gamestate = STATE_LOST then gosub drawlost

 if gamestate = STATE_ATTRACT then gosub drawdemo

 drawscreen
 goto main

 rem ---- game flow ----
newgame
 score0 = 0
 latches = 0 : latches2 = 0
 demo = 0 : roomi = 0
 lives = 3

 gamestate = STATE_PLAY
 gosub startroom
 return

totitle
 gamestate = STATE_TITLE : statesecs = 0 : stateframes = 0 : demo = 0
 roomi = 0
 gosub startroom
 return

statetick
 stateframes = stateframes + 1
 if stateframes >= 60 then stateframes = 0 : statesecs = statesecs + 1
 return

startdemo
 gosub newgame
 gamestate = STATE_ATTRACT : demo = 1
 demoi = 0 : demon = demoinput[1]
 return

demoread
 if demon = 0 then gosub totitle : return
 pad1 = demoinput[demoi]
 demon = demon - 1
 if demon then return
 demoi = demoi + 2
 tmp = demoi + 1 : demon = demoinput[tmp]
 return

startroom
 rem the room's walls are drawn once and saved; starting the same room again (a new game,
 rem the title, "start the room again") keeps them, so a restart fits in its frame
 if drawnroom = roomi then goto srdrawn
 clearscreen
 plotmap roommap 3 0 2 20 22 0 0 40
 plotmap roommap 3 80 2 20 22 20 0 40
 savescreen
 drawnroom = roomi
srdrawn
 roomnum = roomi + 1
 for oi = 0 to 23 : otype[oi] = EMPTY : next
 tk = roomfirst[roomi] : tend = roomend[roomi]
 if tk = tend then goto srplaced
srplace
 sl = spslot[tk]
 if otype[sl] <> EMPTY then goto srnext
 ot = sptype[tk] : otype[sl] = ot
 ox[sl] = spx[tk] : oy[sl] = spy[tk]
 osx[sl] = ox[sl] : osy[sl] = oy[sl]
 ofx[sl] = 0 : ofy[sl] = 0
 ovx[sl] = typevx[ot] : ovxl[sl] = typevxl[ot]
 ovy[sl] = typevy[ot] : ovyl[sl] = typevyl[ot]
 oprot[sl] = 0
srnext
 tk = tk + 1
 if tk < tend then goto srplace
srplaced
 rem nothing resets per room
 seconds = 0 : secondtick = 0 : msgs = 0
 if gamestate = STATE_TITLE then goto startroomdone
 rem audio: a room's music starts here (reserved for kit/audio.ts)
 rem no room start rules
startroomdone
 rem ---- user_startroom: your code, at the end of every room start ----
 rem (empty)
 return

 rem ---- movement: one compiled loop per kind of thing ----
moveall
 rem ---- Cat: joystick 1 (4way, direct), velocity, walls: slide, edges: stop ----
 mi = 0
 if otype[mi] <> T_CAT then goto upd_cat_next
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
 if !pad1{2} then goto upd_cat_8
 ovx[mi] = 255 : ovxl[mi] = 0
 goto upd_cat_ctl
upd_cat_8
 if !pad1{3} then goto upd_cat_9
 ovx[mi] = 1 : ovxl[mi] = 0
 goto upd_cat_ctl
upd_cat_9
 if !pad1{0} then goto upd_cat_10
 ovy[mi] = 255 : ovyl[mi] = 0
 goto upd_cat_ctl
upd_cat_10
 if !pad1{1} then goto upd_cat_11
 ovy[mi] = 1 : ovyl[mi] = 0
 goto upd_cat_ctl
upd_cat_11
upd_cat_ctl
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 ofx[mi] = tmp
 if stp = 0 then goto upd_cat_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_cat_y
 if blocked = 1 then goto upd_cat_12
 ovx[mi] = 0 : ovxl[mi] = 0
 goto upd_cat_y
upd_cat_12
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_cat_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 ofy[mi] = tmp
 if stp = 0 then goto upd_cat_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_cat_d
 if blocked = 1 then goto upd_cat_13
 ovy[mi] = 0 : ovyl[mi] = 0
 goto upd_cat_d
upd_cat_13
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_cat_d
upd_cat_next
 rem ---- Dust ghost: steers toward the nearest Cat, velocity (alternate frames), walls: slide, edges: stop ----
 for mi = 1 to 2
 if otype[mi] <> T_GHOST then goto upd_ghost_next
 tmp = mi ^ frame
 tmp = tmp & 1
 if tmp then goto upd_ghost_next
 sk = 0
 if otype[sk] <> T_CAT then goto upd_ghost_str
 ovx[mi] = 0 : ovxl[mi] = 0
 tmp = ox[sk]
 if ox[mi] < tmp then goto upd_ghost_14
 if ox[mi] = tmp then goto upd_ghost_16
upd_ghost_15
 ovx[mi] = 255 : ovxl[mi] = 192
 goto upd_ghost_16
upd_ghost_14
 ovx[mi] = 0 : ovxl[mi] = 64
upd_ghost_16
 ovy[mi] = 0 : ovyl[mi] = 0
 tmp = oy[sk]
 if oy[mi] < tmp then goto upd_ghost_17
 if oy[mi] = tmp then goto upd_ghost_19
upd_ghost_18
 ovy[mi] = 255 : ovyl[mi] = 192
 goto upd_ghost_19
upd_ghost_17
 ovy[mi] = 0 : ovyl[mi] = 64
upd_ghost_19
upd_ghost_str
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 amt = tmp + ovxl[mi] : stp = stp + ovx[mi]
 if amt < tmp then stp = stp + 1
 tmp = amt
 ofx[mi] = tmp
 if stp = 0 then goto upd_ghost_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_ghost_y
 if blocked = 1 then goto upd_ghost_20
 ovx[mi] = 0 : ovxl[mi] = 0
 goto upd_ghost_y
upd_ghost_20
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_ghost_y
 tmp = ofy[mi] + ovyl[mi] : stp = ovy[mi]
 if tmp < ofy[mi] then stp = stp + 1
 amt = tmp + ovyl[mi] : stp = stp + ovy[mi]
 if amt < tmp then stp = stp + 1
 tmp = amt
 ofy[mi] = tmp
 if stp = 0 then goto upd_ghost_d
 nx = ox[mi] : ny = oy[mi] + stp
 wid = 8 : hgt = 12
 gosub trymovesized
 if blocked = 0 then goto upd_ghost_d
 if blocked = 1 then goto upd_ghost_21
 ovy[mi] = 0 : ovyl[mi] = 0
 goto upd_ghost_d
upd_ghost_21
 ovx[mi] = 0 : ovxl[mi] = 0
 ovy[mi] = 0 : ovyl[mi] = 0
upd_ghost_d
upd_ghost_next
 next
 rem Yarn ball: doesn't move
 rem ---- Bat: velocity (alternate frames), walls: bounce, edges: bounce ----
 mi = 14
 if otype[mi] <> T_BAT then goto upd_bat_next
 tmp = mi ^ frame
 tmp = tmp & 1
 if tmp then goto upd_bat_next
 tmp = ofx[mi] + ovxl[mi] : stp = ovx[mi]
 if tmp < ofx[mi] then stp = stp + 1
 amt = tmp + ovxl[mi] : stp = stp + ovx[mi]
 if amt < tmp then stp = stp + 1
 tmp = amt
 ofx[mi] = tmp
 if stp = 0 then goto upd_bat_y
 nx = ox[mi] + stp : ny = oy[mi]
 wid = 8 : hgt = 8
 gosub trymovesized
 if blocked = 0 then goto upd_bat_y
 if blocked = 1 then goto upd_bat_22
 tmp = ovxl[mi] : px = ovx[mi]
 if tmp = 0 then ovx[mi] = 0 - px
 if tmp <> 0 then ovxl[mi] = 0 - tmp : ovx[mi] = 255 - px
 goto upd_bat_y
upd_bat_22
 tmp = ovxl[mi] : px = ovx[mi]
 if tmp = 0 then ovx[mi] = 0 - px
 if tmp <> 0 then ovxl[mi] = 0 - tmp : ovx[mi] = 255 - px
upd_bat_y
upd_bat_d
upd_bat_next
 return

 rem ---- movement helpers ----
 rem trymovesized: move slot mi (wid x hgt) to (nx, ny) unless something is in the way;
 rem blocked = 1 for a screen edge, 2 for a wall. trymoveedge doesn't check walls.
trymoveedge
 blocked = 1
 if nx > 159 then return
 tmp = nx + wid - 1
 if tmp > 159 then return
 if ny < ROOMTOP then return
 if ny > 191 then return
 tmp = ny + hgt - 1
 if tmp > 191 then return
 blocked = 0
 ox[mi] = nx : oy[mi] = ny
 return

trymovesized
 blocked = 1
 if nx > 159 then return
 tmp = nx + wid - 1
 if tmp > 159 then return
 if ny < ROOMTOP then return
 if ny > 191 then return
 tmp = ny + hgt - 1
 if tmp > 191 then return
 blocked = 2
 rem every move is along one axis: check only the edge that leads
 if nx = ox[mi] then goto trymovev
 rem horizontal: the leading column, at the top and bottom rows (things are at most 16 lines tall);
 rem walls only need checking when the leading edge enters a new 8-pixel column
 px = nx : tmp = ox[mi]
 if nx > ox[mi] then px = nx + wid - 1 : tmp = tmp + wid - 1
 tc = px / 8 : tmp = tmp / 8
 if tc = tmp then goto trymoveok
 py = ny : gosub wallat : if cell = TILE_WALL then return
 py = ny + hgt - 1 : gosub wallat : if cell = TILE_WALL then return
 goto trymoveok
trymovev
 rem vertical: the leading row, at the left, middle and right columns (up to 16 pixels wide);
 rem only when the leading edge enters a new 16-line row
 py = ny : tmp = oy[mi]
 if ny > oy[mi] then py = ny + hgt - 1 : tmp = tmp + hgt - 1
 tc = py / 16 : tmp = tmp / 16
 if tc = tmp then goto trymoveok
 px = nx : gosub wallat : if cell = TILE_WALL then return
 px = nx + wid - 1 : gosub wallat : if cell = TILE_WALL then return
 if wid <= 8 then goto trymoveok
 px = nx + 8 : gosub wallat : if cell = TILE_WALL then return
trymoveok
 blocked = 0
 ox[mi] = nx : oy[mi] = ny
 return

 rem wallat: cell = the tile at pixel (px, py): 0 empty, TILE_WALL, TILE_HAZARD or TILE_GOAL; py must be >= ROOMTOP
wallat
 cell = py - ROOMTOP
 cell = cell / 16
 cell = rowoffset[cell]
 tmp = px / 8
 cell = cell + tmp
 cell = roomwalls[cell]
 return

 rem offscreen: tmp = 1 when slot mi (wid x hgt) is wholly off the screen
offscreen
 tmp = 1
 if ox[mi] < 160 then goto offy
 tmp2 = ox[mi] + wid
 if tmp2 = 0 then return
 if tmp2 >= 160 then return
offy
 if oy[mi] >= 192 then return
 tmp2 = oy[mi] + hgt
 if tmp2 <= ROOMTOP then return
 tmp = 0
 return

 rem nearest: nbest = the slot of the nearest thing of kind ntype (slots nlo-nhi) to slot nfrom,
 rem by |dx| + |dy|, or EMPTY when there's none
nearest
 nbest = EMPTY : nbestd = 255
 px = ox[nfrom] : py = oy[nfrom]
 for nn = nlo to nhi
 if otype[nn] <> ntype then goto nearnext
 if nn = nfrom then goto nearnext
 if ox[nn] >= px then tmp = ox[nn] - px else tmp = px - ox[nn]
 if oy[nn] >= py then tmp2 = oy[nn] - py else tmp2 = py - oy[nn]
 tmp = tmp + tmp2
 if tmp < tmp2 then tmp = 254
 if tmp < nbestd then nbestd = tmp : nbest = nn
nearnext
 next
 return

 rem ---- removing things (each runs its kind's "destroyed" rules) ----
kill_cat
 rem remove a Cat
 otype[ds] = EMPTY
 return

kill_ghost
 rem remove a Dust ghost
 otype[ds] = EMPTY
 return

kill_yarn
 rem remove a Yarn ball
 otype[ds] = EMPTY
 return

kill_bat
 rem remove a Bat
 otype[ds] = EMPTY
 return

 rem ---- timers: four slots a frame, so each slot counts down every tenth of a second ----
tick
 tick6 = tick6 + 1
 if tick6 >= 6 then tick6 = 0
 tk = tick6 * 4 : tend = tk + 4
tickloop
 if oprot[tk] then oprot[tk] = oprot[tk] - 1
ticknext
 tk = tk + 1
 if tk < tend then goto tickloop
 return

 rem ---- rules (generated from the project), in order ----
rules
 oddframe = frame & 1
 rem rule 1: When Cat touches Yarn ball: remove the Yarn ball, add 10 points and play Blip.
rule1
 oi = 0
 if otype[oi] <> T_CAT then goto rule1_ni
 if oprot[oi] then goto rule1_ni
 x1 = ox[oi] : y1 = oy[oi]
 for oj = 3 to 13
 if otype[oj] <> T_YARN then goto rule1_nj_1
 if oprot[oj] then goto rule1_nj_1
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 12, x2, y2, 4, 6) then gosub rule1_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule1_ni
rule1_nj_1
 next
rule1_ni
rule1_end

 rem rule 2: When Cat touches Dust ghost: take 1 from Lives, send every Cat back to start, protect every
 rem   Cat for 1.5 seconds and play Falling tone.
rule2
 oi = 0
 if otype[oi] <> T_CAT then goto rule2_ni
 if oprot[oi] then goto rule2_ni
 x1 = ox[oi] : y1 = oy[oi]
 for oj = 1 to 2
 if otype[oj] <> T_GHOST then goto rule2_nj_2
 if oprot[oj] then goto rule2_nj_2
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 12, x2, y2, 8, 12) then gosub rule2_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule2_ni
rule2_nj_2
 next
rule2_ni
rule2_end

 rem rule 3: When Cat touches Bat: take 1 from Lives, send every Cat back to start, protect every Cat for
 rem   1.5 seconds and play Falling tone.
rule3
 oi = 0
 if otype[oi] <> T_CAT then goto rule3_ni
 if oprot[oi] then goto rule3_ni
 x1 = ox[oi] : y1 = oy[oi]
 oj = 14
 if otype[oj] <> T_BAT then goto rule3_nj_5
 if oprot[oj] then goto rule3_nj_5
 x2 = ox[oj] : y2 = oy[oj]
 if boxcollision(x1, y1, 8, 12, x2, y2, 8, 8) then gosub rule3_do
 if ruleexit then return
 if otype[oi] <> T_CAT then goto rule3_ni
rule3_nj_5
rule3_ni
rule3_end

 rem rule 4: When the number of Yarn ball is 0: play Chime and win the game.
rule4
 if oddframe = 0 then goto rule4_end
 tmp2 = 0
 for ck = 3 to 13
 if otype[ck] = T_YARN then tmp2 = tmp2 + 1
 next
 if tmp2 <> 0 then goto rule4_off
 if latches{0} then goto rule4_end
 latches{0} = 1
 gosub rule4_do
 if ruleexit then return
 goto rule4_end
rule4_off
 latches{0} = 0
rule4_end

 rem rule 5: When Lives is 0: lose the game.
rule5
 if oddframe = 0 then goto rule5_end
 if lives <> 0 then goto rule5_off
 if latches{1} then goto rule5_end
 latches{1} = 1
 gosub rule5_do
 if ruleexit then return
 goto rule5_end
rule5_off
 latches{1} = 0
rule5_end

 return

