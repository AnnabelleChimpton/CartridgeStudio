 rem ---- what each rule does ----
rule1_do
 ds = oj : gosub kill_yarn
 score0 = score0 + 10
 playsfx sfx_blip
 return

rule2_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_3
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_3
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_4
 oprot[ak] = 15
tgt_4
 playsfx sfx_down
 return

rule3_do
 tmp = 1
 if lives < tmp then lives = 0 else lives = lives - tmp
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_6
 ox[ak] = osx[ak] : oy[ak] = osy[ak]
tgt_6
 ak = 0
 if otype[ak] <> T_CAT then goto tgt_7
 oprot[ak] = 15
tgt_7
 playsfx sfx_down
 return

rule4_do
 playsfx sfx_chime
 gamestate = STATE_WON : statesecs = 0 : ruleexit = 1
 rem audio: the winning jingle plays here (reserved for kit/audio.ts)
 return

rule5_do
 gamestate = STATE_LOST : statesecs = 0 : ruleexit = 1
 rem audio: the losing jingle plays here (reserved for kit/audio.ts)
 return

