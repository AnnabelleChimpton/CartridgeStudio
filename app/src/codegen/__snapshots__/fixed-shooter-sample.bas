 rem Cat vs. Vacuums - generated by Cartridge Studio
 rem template fixed-shooter 0.2.0. Do not edit; regenerate from the project.
 displaymode 160A
 set zoneheight 8
 set romsize 32k
 set screenheight 192

 rem 7800basic 0.41 pitfalls this engine avoids (see templates/README.md):
 rem never multiply by a const name, never pass a const as a
 rem plotsprite or boxcollision position, set characterset before plotvalue.

 dim playerx = a
 dim shotx = b
 dim shoty = c
 dim shotactive = d
 dim formx = e
 dim formy = f
 dim formdir = g
 dim movetimer = h
 dim lives = i
 dim wave = j
 dim gamestate = k
 dim statetimer = l
 dim enemiesleft = m
 dim row = n
 dim col = o
 dim idx = p
 dim ex = q
 dim ey = r
 dim bombx = s
 dim bomby = t
 dim bombactive = u
 dim moveinterval = v
 dim livesbcd = w
 dim fireheld = x
 dim rnd = y
 dim leftcol = z
 dim alive = var0
 rem alive uses var0-var17
 dim rightcol = var20
 dim animframe = var21
 dim animtimer = var22

 const PLAYERY = 168
 const SHIPSPEED = 2
 const SHOTSPEED = 4
 const ENEMYSTEP = 2
 const STARTINTERVAL = 8
 const WAVESPEEDUP = 1
 const MININTERVAL = 4
 const STARTLIVES = 3
 const BOMBSPEED = 2
 const BOMBCHANCE = 6
 rem POINTS is BCD: score math takes a const's value as-is, so 30 points is $30.
 const POINTS = $10
 const COLSPACING = 20
 const ROWSPACING = 14
 const FORMLEFTEDGE = 4
 const FORMRIGHTEDGE = 156
 const FORMTOPY = 24

 incgraphic player.png 160A 0 1 2 3
 incgraphic enemy.png 160A 0 1 2 3
 incgraphic enemy_1.png 160A 0 1 2 3
 incgraphic shot.png 160A 0 1 2 3
 incgraphic bomb.png 160A 0 1 2 3
 incgraphic font.png 160A 0 1 2 3
 characterset font

 rem palette ship
 P0C1 = $3A : P0C2 = $02 : P0C3 = $0F
 rem palette enemy
 P1C1 = $96 : P1C2 = $42 : P1C3 = $90
 rem palette shot
 P2C1 = $0F : P2C2 = $1C : P2C3 = $1C
 rem palette bomb
 P3C1 = $46 : P3C2 = $46 : P3C3 = $46
 rem palette hud
 P4C1 = $0F : P4C2 = $0F : P4C3 = $0F
 BACKGRND = $00

 rem gamestate: 0 playing, 1 dying, 2 game over, 3 title (waiting for fire)
 gosub newgame
 gamestate = 3

main
 clearscreen
 if !joy0fire then fireheld = 0
 if gamestate = 3 then goto title
 if gamestate = 2 then goto gameover
 if gamestate = 1 then goto dying

 if joy0left && playerx > 2 then playerx = playerx - SHIPSPEED
 if joy0right && playerx < 142 then playerx = playerx + SHIPSPEED
 if joy0fire && fireheld = 0 then fireheld = 1 : gosub hook_input_fire

 if shotactive = 0 then goto skipshot
 shoty = shoty - SHOTSPEED
 if shoty < 10 then shotactive = 0 : goto skipshot
 gosub checkshothits
 if enemiesleft = 0 then gosub hook_enemies_cleared
skipshot

 movetimer = movetimer + 1
 if movetimer < moveinterval then goto skipmove
 movetimer = 0
 if formdir = 0 then formx = formx + ENEMYSTEP else formx = formx - ENEMYSTEP
 rem bounce off the edges using the outermost columns still alive
 ex = leftcol * 20
 ex = ex + formx
 ey = rightcol * 20
 ey = ey + formx + 12
 if formdir = 0 && ey > FORMRIGHTEDGE then formdir = 1 : formy = formy + 8
 if formdir = 1 && ex < FORMLEFTEDGE then formdir = 0 : formy = formy + 8
 ey = formy + 36
 if ey > PLAYERY then formy = FORMTOPY : gosub hook_player_touches_enemy
skipmove

 if bombactive then goto movebomb
 rnd = rand
 if rnd > BOMBCHANCE then goto skipbomb
 rnd = rand
 col = rnd & 7
 if col > 5 then goto skipbomb
 idx = col + 12 : ey = formy + 28
 if alive[idx] = 1 then goto dropbomb
 idx = col + 6 : ey = formy + 14
 if alive[idx] = 1 then goto dropbomb
 idx = col : ey = formy
 if alive[idx] = 0 then goto skipbomb
dropbomb
 bombx = col * 20
 bombx = bombx + formx + 4
 bomby = ey + 8
 bombactive = 1
 goto skipbomb
movebomb
 bomby = bomby + BOMBSPEED
 if bomby > 184 then bombactive = 0 : goto skipbomb
 ey = PLAYERY
 if boxcollision(bombx, bomby, 4, 4, playerx, ey, 16, 16) then bombactive = 0 : gosub hook_player_touches_enemy
skipbomb
 goto draw

dying
 statetimer = statetimer - 1
 if statetimer > 0 then goto draw
 shotactive = 0 : bombactive = 0
 if lives = 0 then gamestate = 2 else gamestate = 0
 goto draw

gameover
 if joy0fire && fireheld = 0 then fireheld = 1 : gosub newgame
 goto draw

title
 if joy0fire && fireheld = 0 then fireheld = 1 : gamestate = 0

draw
 animtimer = animtimer + 1
 if animtimer > 15 then animtimer = 0 : animframe = animframe ^ 1
 plotvalue font 4 score0 6 4 1
 livesbcd = converttobcd(lives)
 plotvalue font 4 livesbcd 1 148 1
 idx = 0 : ey = formy
 for row = 0 to 2
 ex = formx
 for col = 0 to 5
 if alive[idx] = 1 then plotsprite enemy 1 ex ey animframe
 ex = ex + COLSPACING
 idx = idx + 1
 next
 ey = ey + ROWSPACING
 next
 if shotactive then plotsprite shot 2 shotx shoty
 if bombactive then plotsprite bomb 3 bombx bomby
 rnd = statetimer & 4
 if gamestate = 1 && rnd = 0 then goto skipplayer
 if gamestate = 2 then goto skipplayer
 rnd = animtimer & 8
 if gamestate = 3 && rnd = 0 then goto skipplayer
 ey = PLAYERY
 plotsprite player 0 playerx ey
skipplayer
 drawscreen
 goto main

checkshothits
 if shoty < formy then return
 ey = formy + 36
 if shoty > ey then return
 idx = 0 : ey = formy
 for row = 0 to 2
 ex = formx
 for col = 0 to 5
 if alive[idx] = 0 then goto nexthitcol
 if boxcollision(shotx, shoty, 4, 6, ex, ey, 12, 8) then gosub enemyhit : return
nexthitcol
 ex = ex + COLSPACING
 idx = idx + 1
 next
 ey = ey + ROWSPACING
 next
 return

enemyhit
 alive[idx] = 0 : shotactive = 0 : enemiesleft = enemiesleft - 1
 playsfx sfx_hit
 gosub updatebounds
 gosub hook_shot_hits_enemy
 return

updatebounds
 leftcol = 5 : rightcol = 0 : idx = 0
 for row = 0 to 2
 for col = 0 to 5
 if alive[idx] = 0 then goto nextboundcol
 if col < leftcol then leftcol = col
 if col > rightcol then rightcol = col
nextboundcol
 idx = idx + 1
 next
 next
 return

newgame
 score0 = 0
 lives = STARTLIVES
 wave = 0
 moveinterval = STARTINTERVAL
 playerx = 72
 gamestate = 0
 fireheld = 1
 gosub setupwave
 return

setupwave
 for idx = 0 to 17 : alive[idx] = 1 : next
 enemiesleft = 18
 leftcol = 0 : rightcol = 5
 formx = 24 : formy = FORMTOPY : formdir = 0 : movetimer = 0
 shotactive = 0 : bombactive = 0
 return

 rem ---- hooks: filled from the project's rules ----
hook_input_fire
 rem rule 2: input.fire -> player.shoot
 gosub action_player_shoot
 return

hook_shot_hits_enemy
 rem rule 3: shot.hits.enemy -> score.add
 gosub action_score_add
 return

hook_player_touches_enemy
 rem rule 1: player.touches.enemy -> lives.lose
 gosub action_lives_lose
 return

hook_enemies_cleared
 rem rule 4: enemies.cleared -> wave.next
 gosub action_wave_next
 return

 rem ---- actions used by the rules ----
 rem action player.shoot
action_player_shoot
 if shotactive then return
 shotactive = 1 : shotx = playerx + 6 : shoty = PLAYERY - 6
 playsfx sfx_shoot
 return

 rem action score.add
action_score_add
 score0 = score0 + POINTS
 return

 rem action lives.lose
action_lives_lose
 if gamestate then return
 if lives > 0 then lives = lives - 1
 gamestate = 1 : statetimer = 90
 playsfx sfx_lose
 return

 rem action wave.next
action_wave_next
 wave = wave + 1
 if moveinterval > MININTERVAL then moveinterval = moveinterval - WAVESPEEDUP
 gosub setupwave
 playsfx sfx_wave
 return

 rem ---- sound effects ----
 rem sound hit: boom
 data sfx_hit
 $10, $0A, $01
 $04, $08, $0F
 $07, $08, $0D
 $0A, $08, $0C
 $0D, $08, $0A
 $10, $08, $09
 $13, $08, $07
 $16, $08, $06
 $19, $08, $04
 $1C, $08, $03
 $1F, $08, $01
 $00, $00, $00
end

 rem sound shoot: zap
 data sfx_shoot
 $10, $08, $00
 $03, $04, $0A
 $05, $04, $09
 $07, $04, $08
 $09, $04, $07
 $0B, $04, $06
 $0D, $04, $05
 $0F, $04, $04
 $11, $04, $03
 $00, $00, $00
end

 rem sound lose: down
 data sfx_lose
 $10, $0C, $02
 $08, $04, $0C
 $0A, $04, $0B
 $0C, $04, $0B
 $0E, $04, $0A
 $10, $04, $09
 $12, $04, $08
 $14, $04, $08
 $16, $04, $07
 $18, $04, $06
 $1A, $04, $05
 $1C, $04, $05
 $1E, $04, $04
 $00, $00, $00
end

 rem sound wave: up
 data sfx_wave
 $10, $0B, $01
 $18, $04, $0A
 $16, $04, $0A
 $14, $04, $0A
 $12, $04, $0A
 $10, $04, $0A
 $0E, $04, $0A
 $0C, $04, $0A
 $0A, $04, $0A
 $08, $04, $0A
 $06, $04, $0A
 $04, $04, $0A
 $00, $00, $00
end
