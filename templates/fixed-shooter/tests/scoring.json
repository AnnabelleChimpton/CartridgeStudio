    { "until": { "score": { "gte": 120 } }, "maxFrames": 3000, "steps": [{ "hold": ["fire"], "frames": 2 }, { "frames": 10 }] },
    { "expect": { "score": { "multipleOf": 40 }, "enemiesLeft": { "lt": 18 } } }
  ]
}
