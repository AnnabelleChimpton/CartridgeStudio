 "rules": [
  {
   "id": "r-1",
   "when": {
    "touch": [ "knight", "key" ]
   },
   "then": [
    { "id": "a-2", "destroy": "other" },
    {
     "id": "a-3",
     "add": {
      "what": { "counter": "keys" },
      "by": 1
     }
    },
    {
     "id": "a-4",
     "add": {
      "what": { "counter": "score" },
      "by": 50
     }
    },
    { "id": "a-5", "sound": "up" }
   ]
  },
  {
   "id": "r-6",
   "when": {
    "touch": [ "knight", "door" ]
   },
   "if": [
    {
     "a": { "counter": "keys" },
     "op": "gte",
     "b": 1
    }
   ],
   "then": [
    { "id": "a-7", "destroy": "other" },
    {
     "id": "a-8",
     "take": {
      "what": { "counter": "keys" },
      "by": 1
     }
    },
    {
     "id": "a-9",
     "add": {
      "what": { "counter": "score" },
      "by": 100
     }
    },
    { "id": "a-10", "sound": "chime" }
   ]
  },
  {
   "id": "r-11",
   "when": {
    "touch": [ "knight", "door" ]
   },
   "if": [
    {
     "a": { "counter": "keys" },
     "op": "eq",
     "b": 0
    }
   ],
   "then": [
    { "id": "a-12", "toStart": "it" },
    { "id": "a-13", "sound": "down" }
   ]
  },
  {
   "id": "r-14",
