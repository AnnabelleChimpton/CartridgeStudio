{
 "kit": 2,
 "title": "Ghost Panic",
 "palettes": [
  {
   "id": "hero",
   "colors": [ "$1C", "$02", "$46" ]
  },
  {
   "id": "ghost",
   "colors": [ "$56", "$0F", "$02" ]
  },
  {
   "id": "coin",
   "colors": [ "$1E", "$2A", "$00" ]
  },
  {
   "id": "walls",
   "colors": [ "$84", "$82", "$36" ]
  },
  {
   "id": "text",
   "colors": [ "$0F", "$0F", "$0F" ]
  },
  {
   "id": "scared",
   "colors": [ "$86", "$0F", "$02" ]
  },
  {
   "id": "catnip",
   "colors": [ "$C8", "$C4", "$84" ]
  }
 ],
 "background": "$00",
 "wallPalette": "walls",
 "textPalette": "text",
 "types": [
  {
   "id": "cat",
   "label": "Cat",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11111111", "11133111", "01111110", "00111100", "01111110", "11111111", "10111101", "00100100", "01100110" ]
   ],
   "palette": "hero",
   "control": {
    "joystick": 1,
    "axes": "4way",
    "mode": "direct",
    "speed": { "step": 3 }
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" }
  },
  {
   "id": "ghost",
   "label": "Dust ghost",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "10101010", "00000000" ],
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "01010101", "00000000" ]
   ],
   "palette": "ghost",
   "steer": {
    "toward": "cat",
    "speed": { "step": 1, "plus": "pace", "max": 4 },
    "every": 1
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" },
   "display": { "animate": 16 }
  },
  {
   "id": "scared",
   "label": "Scared ghost",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "10101010", "00000000" ],
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "01010101", "00000000" ]
   ],
   "palette": "scared",
   "steer": {
    "toward": "cat",
    "away": true,
    "speed": { "step": 1, "plus": "pace", "max": 4 },
    "every": 1
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" },
   "display": { "animate": 16 }
  },
  {
   "id": "fast-ghost",
   "label": "Fast ghost",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "10101010", "00000000" ],
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "01010101", "00000000" ]
   ],
   "palette": "ghost",
   "steer": {
    "toward": "cat",
    "speed": { "step": 2, "plus": "pace", "max": 4 },
    "every": 1
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" },
   "display": { "animate": 16 }
  },
  {
   "id": "yarn",
   "label": "Yarn ball",
   "width": 4,
   "height": 6,
   "frames": [
    [ "0110", "1221", "1221", "1221", "1221", "0110" ]
   ],
   "palette": "coin",
   "move": { "vx": 0, "vy": 0, "wall": "stop", "edge": "stop" }
  },
  {
   "id": "catnip",
   "label": "Catnip",
   "width": 8,
   "height": 8,
   "frames": [
    [ "00011000", "00122100", "01222210", "12233221", "01222210", "00122100", "00011000", "00030000" ]
   ],
   "palette": "catnip",
   "move": { "vx": 0, "vy": 0, "wall": "stop", "edge": "stop" }
  }
 ],
 "room": {
  "rows": [
   "####################",
   "#P  y   N   #  y  G#",
   "#  ###  ###   ###  #",
   "#y #            #  #",
   "#  #  ####  ### # y#",
   "#        ~     y   #",
   "# y  ###  ##  ###  #",
   "#  #       # ~  #  #",
   "#  #  #######   #y #",
   "#N                G#",
   "####################"
  ],
  "legend": { "#": "wall", "P": "cat", "G": "ghost", "y": "yarn", "N": "catnip", "~": "hazard" }
 },
 "counters": [
  { "id": "lives", "label": "Lives", "start": 3 },
  { "id": "level", "label": "Level", "start": 1 },
  { "id": "pace", "label": "Pace", "start": 0 },
  { "id": "combo", "label": "Combo", "start": 0 }
 ],
 "hud": [
  { "show": "score", "at": "left" },
  { "show": "lives", "at": "right" }
 ],
 "rules": [
  {
   "id": "r-1",
   "when": {
    "touch": [ "cat", "yarn" ]
   },
   "fires": "while",
   "then": [
    { "id": "a-1-1", "destroy": "other" },
    {
     "id": "a-1-2",
     "add": {
      "what": { "counter": "score" },
      "by": 10
     }
    },
    { "id": "a-1-3", "sound": "blip" }
   ]
  },
  {
   "id": "r-2",
   "when": {
    "touch": [ "cat", "catnip" ]
   },
   "fires": "while",
   "then": [
    { "id": "a-2-1", "destroy": "other" },
    {
     "id": "a-2-2",
     "set": {
      "what": { "counter": "combo" },
      "to": 0
     }
    },
    {
     "id": "a-2-3",
     "turn": {
      "who": { "every": "ghost" },
      "into": "scared",
      "seconds": 6
     }
    },
    {
     "id": "a-2-4",
     "turn": {
      "who": { "every": "fast-ghost" },
      "into": "scared",
      "seconds": 6
     }
    },
    { "id": "a-2-5", "sound": "up" }
   ]
  },
  {
   "id": "r-3",
   "when": {
    "touch": [ "cat", "scared" ]
   },
   "fires": "while",
   "if": [
    {
     "a": { "counter": "combo" },
     "op": "gte",
     "b": 1
    }
   ],
   "then": [
    {
     "id": "a-3-1",
     "add": {
      "what": { "counter": "score" },
      "by": 300
     }
    },
    { "id": "a-3-2", "sound": "chime" }
   ]
  },
  {
   "id": "r-4",
   "when": {
    "touch": [ "cat", "scared" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-4-1",
     "add": {
      "what": { "counter": "combo" },
      "by": 1
     }
    },
    {
     "id": "a-4-2",
     "add": {
      "what": { "counter": "score" },
      "by": 200
     }
    },
    {
     "id": "a-4-3",
     "turn": { "who": "other", "into": "ghost" }
    },
    { "id": "a-4-4", "toStart": "other" },
    { "id": "a-4-5", "sound": "boom" }
   ]
  },
  {
   "id": "r-5",
   "when": {
    "touch": [ "cat", "ghost" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-5-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-5-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-5-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-5-2", "sound": "down" }
   ]
  },
  {
   "id": "r-6",
   "when": {
    "onTile": [ "cat", "hazard" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-6-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-6-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-6-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-6-2", "sound": "crash" }
   ]
  },
  {
   "id": "r-7",
   "when": {
    "touch": [ "cat", "fast-ghost" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-7-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-7-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-7-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-7-2", "sound": "down" }
   ]
  },
  {
   "id": "r-8",
   "when": { "every": 15 },
   "then": [
    {
     "id": "a-8-1",
     "turn": {
      "who": { "every": "ghost" },
      "into": "fast-ghost",
      "seconds": 4
     }
    },
    { "id": "a-8-2", "sound": "zap" }
   ]
  },
  {
   "id": "r-9",
   "when": {
    "test": {
     "a": { "count": "yarn" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-9-1", "sound": "chime" },
    {
     "id": "a-9-2-u",
     "add": {
      "what": { "counter": "level" },
      "by": 1
     }
    },
    { "id": "a-9-2", "restartRoom": true }
   ]
  },
  {
   "id": "r-10",
   "when": {
    "test": {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 4
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-10-1", "gameOver": "won" }
   ]
  },
  {
   "id": "r-p-lives",
   "when": {
    "test": {
     "a": { "counter": "lives" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-p-lives", "gameOver": "lost" }
   ]
  },
  {
   "id": "r-p-pace3",
   "when": { "roomStart": true },
   "if": [
    {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 3
    }
   ],
   "then": [
    {
     "id": "a-p-pace3",
     "set": {
      "what": { "counter": "pace" },
      "to": 1
     }
    }
   ]
  },
  {
   "id": "r-p-pace5",
   "when": { "roomStart": true },
   "if": [
    {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 5
    }
   ],
   "then": [
    {
     "id": "a-p-pace5",
     "set": {
      "what": { "counter": "pace" },
      "to": 2
     }
    }
   ]
  },
  {
   "id": "r-p-pace7",
   "when": { "roomStart": true },
   "if": [
    {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 7
    }
   ],
   "then": [
    {
     "id": "a-p-pace7",
     "set": {
      "what": { "counter": "pace" },
      "to": 3
     }
    }
   ]
  }
 ],
 "text": { "title": "Ghost Panic", "win": "THREE MAZES CLEAR", "lose": "THE GHOSTS WON" },
 "flow": {
  "title": true,
  "attract": null,
  "end": {
   "show": [ "score" ],
   "after": 0
  },
  "remember": false
 },
 "cartridge": { "manualText": null }
}
