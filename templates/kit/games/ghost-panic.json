 ],
 "room": {
  "rows": [
   "####################",
   "#P  y   N   #  y  G#",
   "#  ###  ###   ###  #",
   "#y #            #  #",
   "#  #  ####  ### # y#",
   "#        ~     y   #",
   "# y  ###  ##  ###  #",
   "#  #       # ~  #  #",
   "#  #  #######   #y #",
   "#N                G#",
   "####################"
  ],
  "legend": { "#": "wall", "P": "cat", "G": "dust", "y": "yarn", "N": "catnip", "~": "hazard" }
 },
 "counters": [
  { "id": "lives", "label": "Lives", "start": 3 },
  { "id": "level", "label": "Level", "start": 1 },
  { "id": "pace", "label": "Pace", "start": 0 },
  { "id": "combo", "label": "Combo", "start": 0 }
 ],
 "hud": [
  { "show": "score", "at": "left" },
  { "show": "lives", "at": "right" }
 ],
 "rules": [
  {
   "id": "r-1",
   "when": {
    "touch": [ "cat", "yarn" ]
   },
   "fires": "while",
   "then": [
    { "id": "a-1-1", "destroy": "other" },
    {
     "id": "a-1-2",
     "add": {
      "what": { "counter": "score" },
      "by": 10
     }
    },
    { "id": "a-1-3", "sound": "blip" }
   ]
  },
  {
   "id": "r-2",
   "when": {
    "touch": [ "cat", "catnip" ]
   },
   "fires": "while",
   "then": [
    { "id": "a-2-1", "destroy": "other" },
    {
     "id": "a-2-2",
     "set": {
      "what": { "counter": "combo" },
      "to": 0
     }
    },
    {
     "id": "a-2-3",
     "turn": {
      "who": { "every": "dust" },
      "into": "scared",
      "seconds": 6
     }
    },
    {
     "id": "a-2-4",
     "turn": {
      "who": { "every": "fast-dust" },
      "into": "scared",
      "seconds": 6
     }
    },
    { "id": "a-2-5", "sound": "up" }
   ]
  },
  {
   "id": "r-3",
   "when": {
    "touch": [ "cat", "scared" ]
   },
   "fires": "while",
   "if": [
    {
     "a": { "counter": "combo" },
     "op": "gte",
     "b": 1
    }
   ],
   "then": [
    {
     "id": "a-3-1",
     "add": {
      "what": { "counter": "score" },
      "by": 300
     }
    },
    { "id": "a-3-2", "sound": "chime" }
   ]
  },
  {
   "id": "r-4",
   "when": {
    "touch": [ "cat", "scared" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-4-1",
     "add": {
      "what": { "counter": "combo" },
      "by": 1
     }
    },
    {
     "id": "a-4-2",
     "add": {
      "what": { "counter": "score" },
      "by": 200
     }
    },
    {
     "id": "a-4-3",
     "turn": { "who": "other", "into": "dust" }
    },
    { "id": "a-4-4", "toStart": "other" },
    { "id": "a-4-5", "sound": "boom" }
   ]
  },
  {
   "id": "r-5",
   "when": {
    "touch": [ "cat", "dust" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-5-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-5-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-5-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-5-2", "sound": "down" }
   ]
  },
  {
   "id": "r-6",
   "when": {
    "onTile": [ "cat", "hazard" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-6-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-6-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-6-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-6-2", "sound": "crash" }
   ]
  },
  {
   "id": "r-7",
   "when": {
    "touch": [ "cat", "fast-dust" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-7-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-7-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-7-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-7-2", "sound": "down" }
   ]
  },
  {
   "id": "r-8",
   "when": { "every": 15 },
   "then": [
    {
     "id": "a-8-1",
     "turn": {
      "who": { "every": "dust" },
      "into": "fast-dust",
      "seconds": 4
     }
    },
    { "id": "a-8-2", "sound": "zap" }
   ]
  },
  {
   "id": "r-9",
   "when": {
    "test": {
     "a": { "count": "yarn" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-9-1", "sound": "chime" },
    {
     "id": "a-9-2-u",
     "add": {
      "what": { "counter": "level" },
      "by": 1
     }
    },
    { "id": "a-9-2", "restartRoom": true }
   ]
  },
  {
   "id": "r-10",
   "when": {
    "test": {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 4
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-10-1", "gameOver": "won" }
   ]
  },
  {
   "id": "r-p-lives",
   "when": {
    "test": {
     "a": { "counter": "lives" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-p-lives", "gameOver": "lost" }
   ]
  },
  {
   "id": "r-p-pace3",
   "when": { "roomStart": true },
   "if": [
    {
     "a": { "counter": "level" },
     "op": "gte",
     "b": 3
    }
   ],
   "then": [
    {
     "id": "a-p-pace3",
     "set": {
      "what": { "counter": "pace" },
      "to": 1
     }
    }
   ]
  }
 ],
 "text": { "title": "Ghost Panic", "win": "HOUSE CLEAN", "lose": "GAME OVER" },
 "flow": {
  "title": true,
  "attract": null,
  "end": {
   "show": [ "score" ],
   "after": 0
  },
  "remember": false
 },
 "cartridge": { "manualText": null }
}
