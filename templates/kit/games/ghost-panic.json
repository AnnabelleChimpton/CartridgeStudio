  "rules": [
    {
      "when": {
        "touch": [
          "cat",
          "yarn"
        ]
      },
      "then": [
        {
          "remove": "second"
        },
        {
          "score": 10
        },
        {
          "sound": "blip"
        }
      ]
    },
    {
      "when": {
        "touch": [
          "cat",
          "catnip"
        ]
      },
      "then": [
        {
          "remove": "second"
        },
        {
          "set": [
            "combo",
            0
          ]
        },
        {
          "turnAll": {
            "type": "ghost",
            "into": "scared",
            "seconds": 6
          }
        },
        {
          "turnAll": {
            "type": "fast-ghost",
            "into": "scared",
            "seconds": 6
          }
        },
        {
          "sound": "up"
        }
      ]
    },
    {
      "when": {
        "touch": [
          "cat",
          "scared"
        ]
      },
      "if": [
        {
          "counter": "combo",
          "op": "gte",
          "value": 1
        }
      ],
      "then": [
        {
          "score": 300
        },
        {
          "sound": "chime"
        }
      ]
    },
    {
      "when": {
        "touch": [
          "cat",
          "scared"
        ]
      },
      "then": [
        {
          "add": [
            "combo",
            1
          ]
        },
        {
          "score": 200
        },
        {
          "turn": {
            "who": "second",
            "into": "ghost"
          }
        },
        {
          "respawn": "second"
        },
        {
          "sound": "boom"
        }
      ]
    },
    {
      "when": {
        "touch": [
          "cat",
          "ghost"
        ]
      },
      "then": [
        {
          "loseLife": true
        },
        {
          "sound": "down"
        }
      ]
    },
    {
      "when": {
        "onTile": [
          "cat",
          "hazard"
        ]
      },
      "then": [
        {
          "loseLife": true
        },
        {
          "sound": "crash"
        }
      ]
    },
    {
      "when": {
        "touch": [
          "cat",
          "fast-ghost"
        ]
      },
      "then": [
        {
          "loseLife": true
        },
        {
          "sound": "down"
        }
      ]
    },
    {
      "when": {
        "every": 15
      },
      "then": [
        {
          "turnAll": {
            "type": "ghost",
            "into": "fast-ghost",
            "seconds": 4
          }
        },
        {
          "sound": "zap"
        }
      ]
    },
    {
      "when": {
        "allGone": "yarn"
      },
      "then": [
        {
          "sound": "chime"
        },
        {
          "nextLevel": true
        }
      ]
    },
    {
      "when": {
        "reaches": [
          "level",
          4
        ]
      },
      "then": [
        {
          "win": true
        }
      ]
    }
  ],
