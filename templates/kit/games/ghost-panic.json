    [ "00010001", "00011111", "10012121", "10011311", "01001110", "01111110", "01212110", "01111110", "00100100", "00300300" ],
    [ "10001000", "11111000", "12121001", "11311001", "01110010", "01111110", "01121210", "01111110", "01000010", "03000030" ],
