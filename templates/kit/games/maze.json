{
 "kit": 2,
 "title": "Yarn Hunt",
 "palettes": [
  {
   "id": "hero",
   "colors": [ "$1C", "$02", "$46" ]
  },
  {
   "id": "ghost",
   "colors": [ "$56", "$0F", "$02" ]
  },
  {
   "id": "coin",
   "colors": [ "$1E", "$2A", "$00" ]
  },
  {
   "id": "walls",
   "colors": [ "$84", "$82", "$00" ]
  },
  {
   "id": "text",
   "colors": [ "$0F", "$0F", "$0F" ]
  },
  {
   "id": "bat",
   "colors": [ "$06", "$46", "$00" ]
  }
 ],
 "background": "$00",
 "wallPalette": "walls",
 "textPalette": "text",
 "types": [
  {
   "id": "cat",
   "label": "Cat",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11111111", "11133111", "01111110", "00111100", "01111110", "11111111", "10111101", "00100100", "01100110" ]
   ],
   "palette": "hero",
   "control": {
    "joystick": 1,
    "axes": "4way",
    "mode": "direct",
    "speed": { "step": 3 }
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" }
  },
  {
   "id": "ghost",
   "label": "Dust ghost",
   "width": 8,
   "height": 12,
   "frames": [
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "10101010", "00000000" ],
    [ "00111100", "01111110", "11211211", "11311311", "11111111", "11111111", "11111111", "11111111", "11111111", "11111111", "01010101", "00000000" ]
   ],
   "palette": "ghost",
   "steer": {
    "toward": "cat",
    "speed": { "step": 1 },
    "every": 1
   },
   "move": { "vx": 0, "vy": 0, "wall": "slide", "edge": "stop" },
   "display": { "animate": 16 }
  },
  {
   "id": "yarn",
   "label": "Yarn ball",
   "width": 4,
   "height": 6,
   "frames": [
    [ "0110", "1221", "1221", "1221", "1221", "0110" ]
   ],
   "palette": "coin",
   "move": { "vx": 0, "vy": 0, "wall": "stop", "edge": "stop" }
  },
  {
   "id": "bat",
   "label": "Bat",
   "width": 8,
   "height": 8,
   "frames": [
    [ "10000001", "11000011", "11111111", "01211210", "00111100", "00011000", "00000000", "00000000" ],
    [ "00000000", "00000000", "00111100", "01211210", "11111111", "11011011", "10000001", "00000000" ]
   ],
   "palette": "bat",
   "move": { "vx": 8, "vy": 0, "wall": "bounce", "edge": "bounce" },
   "display": { "animate": 16 }
  }
 ],
 "room": {
  "rows": [
   "####################",
   "#P  y   y   #  y  G#",
   "#  ###  ###   ###  #",
   "#y #       y    #  #",
   "#  #  ####  ### # y#",
   "#     B        y   #",
   "# y  ###  ##  ###  #",
   "#  #    y  #    #  #",
   "#  #  #######   #y #",
   "#y                G#",
   "####################"
  ],
  "legend": { "#": "wall", "P": "cat", "G": "ghost", "y": "yarn", "B": "bat" }
 },
 "counters": [
  { "id": "lives", "label": "Lives", "start": 3 }
 ],
 "hud": [
  { "show": "score", "at": "left" },
  { "show": "lives", "at": "right" }
 ],
 "rules": [
  {
   "id": "r-1",
   "when": {
    "touch": [ "cat", "yarn" ]
   },
   "fires": "while",
   "then": [
    { "id": "a-1-1", "destroy": "other" },
    {
     "id": "a-1-2",
     "add": {
      "what": { "counter": "score" },
      "by": 10
     }
    },
    { "id": "a-1-3", "sound": "blip" }
   ]
  },
  {
   "id": "r-2",
   "when": {
    "touch": [ "cat", "ghost" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-2-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-2-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-2-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-2-2", "sound": "down" }
   ]
  },
  {
   "id": "r-3",
   "when": {
    "touch": [ "cat", "bat" ]
   },
   "fires": "while",
   "then": [
    {
     "id": "a-3-1-l",
     "take": {
      "what": { "counter": "lives" },
      "by": 1
     }
    },
    {
     "id": "a-3-1-s0",
     "toStart": { "every": "cat" }
    },
    {
     "id": "a-3-1-p0",
     "protect": {
      "who": { "every": "cat" },
      "tenths": 15
     }
    },
    { "id": "a-3-2", "sound": "down" }
   ]
  },
  {
   "id": "r-4",
   "when": {
    "test": {
     "a": { "count": "yarn" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-4-1", "sound": "chime" },
    { "id": "a-4-2", "gameOver": "won" }
   ]
  },
  {
   "id": "r-p-lives",
   "when": {
    "test": {
     "a": { "counter": "lives" },
     "op": "eq",
     "b": 0
    }
   },
   "fires": "once",
   "then": [
    { "id": "a-p-lives", "gameOver": "lost" }
   ]
  }
 ],
 "text": { "title": "Yarn Hunt", "win": "ALL THE YARN", "lose": "CAUGHT BY DUST" },
 "flow": {
  "title": true,
  "attract": { "after": 20 },
  "end": {
   "show": [ "score" ],
   "after": 0
  },
  "remember": false
 },
 "cartridge": { "manualText": null }
}
