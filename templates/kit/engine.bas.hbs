 rem {{title}} - generated by Cartridge Studio (game kit runtime {{runtimeVersion}})
 rem Do not edit; regenerate from the project.
 rem
 rem One generic runtime for every kit game. The project supplies data:
 rem object types and behaviours, a painted room, rules and text. The
 rem generated parts are the data tables, the rule checks, the draw
 rem dispatch and the sounds.
 rem
 rem 7800basic 0.41 pitfalls (templates/README.md): never multiply by a
 rem const name, never pass a const as a plotsprite or boxcollision
 rem position, BCD consts for score math, characterset before plotvalue.

 displaymode 160A
 set zoneheight 8
 set romsize 32k
 set screenheight 192

 autodim init var0 var99
 autodim byte gamestate
 autodim byte statetimer
 autodim byte lives
 autodim byte livesbcd
 autodim byte fireheld
 autodim byte firepressed
 autodim byte rnd
 autodim byte oi
 autodim byte oj
 autodim byte ot
 autodim byte beh
 autodim byte amt
 autodim byte nx
 autodim byte ny
 autodim byte wid
 autodim byte hgt
 autodim byte px
 autodim byte py
 autodim byte cell
 autodim byte blocked
 autodim byte x1
 autodim byte y1
 autodim byte x2
 autodim byte y2
 autodim byte frame
 autodim byte animframe
 autodim byte seconds
 autodim byte secondsbcd
 autodim byte secondtick
 autodim byte invuln
 autodim byte heroi
 autodim byte marchdir
 autodim byte marchmin
 autodim byte marchmax
 autodim byte count
 autodim byte loopslo
 autodim byte loopshi
 autodim byte latches
 autodim byte latches2
 autodim byte levelnum
 autodim byte speedbonus
 autodim byte tk
 autodim byte hudbcd

 rem object tables: 24 slots, otype 255 means empty
 dim otype = $2200
 dim ox = $2218
 dim oy = $2230
 dim odx = $2248
 dim ody = $2260
 dim osx = $2278
 dim osy = $2290
 rem this frame's step in pixels for each type (computed once per frame)
 dim typeamt = $22A8
 rem the step over two frames, for movers that update every other frame
 dim typeamt2 = $22B0
 rem timed "turn into": seconds left, and the type to turn back into
 dim otimer = $22B8
 dim oback = $22D0
{{#if hasVelocity}}
 rem model v2 spike: velocity in quarter pixels per frame (signed), and the
 rem quarter-pixel fraction each thing has built up
 dim ovx = $22E8
 dim ovy = $2300
 dim ofx = $2318
 dim ofy = $2330
 const VELOCITY = 13
{{/if}}

 const STATE_TITLE = 0
 const STATE_PLAY = 1
 const STATE_WON = 2
 const STATE_LOST = 3
 const EMPTY = 255
 const ROOMTOP = 16
 const STARTLIVES = {{lives}}
{{{constants}}}

{{{graphics}}}
 characterset font
 alphachars '{{alphachars}}'

{{{palettes}}}
 BACKGRND = {{background}}

 gamestate = STATE_TITLE
 lives = STARTLIVES
 levelnum = 1
 gosub startroom

main
 restorescreen
 frame = frame + 1
 rnd = frame & 15
 if rnd = 0 then animframe = animframe ^ 1
 rem count main-loop passes (frame-rate checks read this)
 loopslo = loopslo + 1
 if loopslo = 0 then loopshi = loopshi + 1
 firepressed = 0
 if !joy0fire then fireheld = 0
 if joy0fire && fireheld = 0 then fireheld = 1 : firepressed = 1
 on gamestate goto st_title st_play st_end st_end

st_title
 if firepressed then gosub newgame
 goto draw

st_end
 if firepressed then gamestate = STATE_TITLE : gosub startroom
 goto draw

st_play
 if invuln > 0 then invuln = invuln - 1
 secondtick = secondtick + 1
 if secondtick >= 60 then secondtick = 0 : seconds = seconds + 1
{{#if hasTimedTurns}}
 rem timed turns: one slot a frame, so each slot is visited once a second
 if secondtick < 24 then gosub turnback
{{/if}}
 marchmin = 255 : marchmax = 0
 rem speed: typespeed is 0-3; speedsteps holds pixels per frame phase
 rnd = frame & 3
 for ot = 0 to typecount_minus1
 amt = typespeed[ot]
{{#if hasLevels}}
 if typefaster[ot] then amt = amt + speedbonus
 if amt > 3 then amt = 3
{{/if}}
 amt = amt * 4 + rnd
 typeamt[ot] = speedsteps[amt]
 amt = amt ^ 1
 typeamt2[ot] = speedsteps[amt] + typeamt[ot]
 next
 for oi = 0 to 23
 ot = otype[oi]
 if ot = EMPTY then goto nextobj
 beh = typebeh[ot]
{{#if hasVelocity}}
 rem things that move by their own velocity skip the behaviour dispatch
 if beh <> VELOCITY then goto notvelocity
{{#if velocitySlice}}
 rnd = oi ^ frame
 rnd = rnd & 1
 if rnd then goto nextobj
 amt = 2
{{else}}
 amt = 1
{{/if}}
 gosub b_velocity
 goto afterupdate
notvelocity
{{/if}}
 amt = typeamt[ot]
 rem time-slicing: patrollers, bouncers, chasers and fallers (4-7, 9) move on
 rem alternate frames by odd and even slot, twice as far, so speeds don't change
 if beh < 4 then goto updatenow
 if beh = 8 then goto updatenow
 if beh > 9 && beh <> 12 then goto updatenow
 rnd = oi ^ frame
 rnd = rnd & 1
 if rnd then goto nextobj
 amt = typeamt2[ot]
updatenow
 on beh gosub b_still b_player_lr b_player_4 b_player_8 b_patrol_h b_patrol_v b_bounce b_chase b_march b_fall b_proj_up b_proj_down b_flee
afterupdate
{{#if hasDrops}}
 ot = otype[oi]
 if ot = EMPTY then goto nextobj
 if typedrops[ot] <> EMPTY then gosub drops
{{/if}}
nextobj
 next
 rem the formation turns (and steps down) when its outermost marcher reaches an edge
 if marchmax = 0 then goto nomarch
 if marchdir = 1 && marchmax >= 158 then gosub turnmarch
 if marchdir <> 1 && marchmin <= 2 then gosub turnmarch
nomarch
 gosub rules
 goto draw

draw
 plotvalue font {{textPalette}} score0 6 4 0
 livesbcd = converttobcd(lives)
 plotvalue font {{textPalette}} livesbcd 1 152 0
{{#if showTimer}}
 secondsbcd = converttobcd(seconds)
 plotvalue font {{textPalette}} secondsbcd 2 76 0
{{/if}}
{{#if hudCounter}}
 hudbcd = converttobcd({{hudCounter}})
 plotvalue font {{textPalette}} hudbcd 2 120 0
{{/if}}
 for oi = 0 to 23
 ot = otype[oi]
 if ot = EMPTY then goto nextdraw
 px = ox[oi] : py = oy[oi]
 if oi <> heroi then goto drawit
 if invuln = 0 then goto drawit
 rnd = frame & 4
 if rnd then goto nextdraw
drawit
 on ot gosub {{drawLabels}}
nextdraw
 next
 if gamestate = STATE_TITLE then gosub drawtitle
 if gamestate = STATE_WON then gosub drawwon
 if gamestate = STATE_LOST then gosub drawlost
 drawscreen
 goto main

 rem ---- game flow ----
newgame
 score0 = 0
 lives = STARTLIVES
 levelnum = 1
 latches = 0 : latches2 = 0
{{{counterInit}}}
 gosub startroom
 gamestate = STATE_PLAY
 return

startroom
 clearscreen
 plotmap roommap {{wallPalette}} 0 2 20 22 0 0 40
 plotmap roommap {{wallPalette}} 80 2 20 22 20 0 40
 savescreen
 for oi = 0 to 23 : otype[oi] = EMPTY : next
{{#if hasTimedTurns}}
 for oi = 0 to 23 : otimer[oi] = 0 : next
{{/if}}
{{#if hasLevels}}
 speedbonus = levelnum - 1
 speedbonus = speedbonus / 2
 if speedbonus > 3 then speedbonus = 3
{{/if}}
{{{everyInit}}}
 for oi = 0 to spawncount_minus1
 ot = spawntype[oi]
 otype[oi] = ot
 ox[oi] = spawnx[oi] : oy[oi] = spawny[oi]
 osx[oi] = spawnx[oi] : osy[oi] = spawny[oi]
 odx[oi] = 1 : ody[oi] = 1
{{#if hasVelocity}}
 ovx[oi] = typevx[ot] : ovy[oi] = typevy[ot]
 ofx[oi] = 0 : ofy[oi] = 0
{{/if}}
 next
 heroi = EMPTY
 for oi = 0 to 23
 ot = otype[oi]
 if ot = EMPTY then goto nexthero
 beh = typebeh[ot]
 if beh >= 1 && beh <= 3 && heroi = EMPTY then heroi = oi
nexthero
 next
 rem event latches survive a restart (cleared by newgame), so a rule that restarts
 rem the room can't fire again at once just because its condition still holds
 marchdir = 1 : seconds = 0 : secondtick = 0 : invuln = 0
 return

loselife
 if invuln > 0 then return
 if lives > 0 then lives = lives - 1
 invuln = 90
 if lives = 0 then gamestate = STATE_LOST : return
 rem the heroes go back to where they started
 for oj = 0 to 23
 ot = otype[oj]
 if ot = EMPTY then goto nextreset
 beh = typebeh[ot]
 if beh >= 1 && beh <= 3 then ox[oj] = osx[oj] : oy[oj] = osy[oj]
nextreset
 next
 return

 rem ---- movement ----
 rem trymove: move object i to (nx, ny) unless a wall or the screen edge is in the way
trymove
 blocked = 0
 ot = otype[oi]
 wid = typew[ot] : hgt = typeh[ot]
 if nx > 159 then blocked = 1 : return
 if ny > 191 then blocked = 1 : return
 px = nx + wid - 1
 if px > 159 then blocked = 1 : return
 if ny < ROOMTOP then blocked = 1 : return
 py = ny + hgt - 1
 if py > 191 then blocked = 1 : return
{{#if hasWalls}}
 rem every move is along one axis: check only the edge that leads
 if nx = ox[oi] then goto trymovev
 rem horizontal: the leading column, at the top and bottom rows (objects are at most 16 lines tall).
 rem Walls only need checking when the leading edge enters a new 8-pixel column.
 px = nx : rnd = ox[oi]
 if nx > ox[oi] then px = nx + wid - 1 : rnd = rnd + wid - 1
 cell = px / 8 : rnd = rnd / 8
 if cell = rnd then goto trymoveok
 py = ny : gosub wallat : if cell = 1 then blocked = 1 : return
 py = ny + hgt - 1 : gosub wallat : if cell = 1 then blocked = 1 : return
 goto trymoveok
trymovev
 rem vertical: the leading row, at the left, middle and right columns (up to 16 pixels wide);
 rem only when the leading edge enters a new 16-line row.
 py = ny : rnd = oy[oi]
 if ny > oy[oi] then py = ny + hgt - 1 : rnd = rnd + hgt - 1
 cell = py / 16 : rnd = rnd / 16
 if cell = rnd then goto trymoveok
 px = nx : gosub wallat : if cell = 1 then blocked = 1 : return
 px = nx + wid - 1 : gosub wallat : if cell = 1 then blocked = 1 : return
 if wid <= 8 then goto trymoveok
 px = nx + 8 : gosub wallat : if cell = 1 then blocked = 1 : return
trymoveok
{{/if}}
 ox[oi] = nx : oy[oi] = ny
 return

{{#if hasTileMap}}
 rem wallat: cell = the tile at pixel (px, py): 0 empty, 1 wall, 2 hazard, 3 goal; py must be >= ROOMTOP
wallat
 cell = py - ROOMTOP
 cell = cell / 16
 cell = rowoffset[cell]
 rnd = px / 8
 cell = cell + rnd
 cell = roomwalls[cell]
 return
{{/if}}

 rem one step for each behaviour; amt is this frame's pixels (0, 1 or 2)
b_still
 return

b_player_lr
 nx = ox[oi] : ny = oy[oi]
 if joy0left then nx = nx - amt
 if joy0right then nx = nx + amt
 gosub trymove
 goto playerfire

b_player_4
 nx = ox[oi] : ny = oy[oi]
 if joy0left then nx = nx - amt : gosub trymove : goto playerfire
 if joy0right then nx = nx + amt : gosub trymove : goto playerfire
 if joy0up then ny = ny - amt : gosub trymove : goto playerfire
 if joy0down then ny = ny + amt : gosub trymove
 goto playerfire

b_player_8
 nx = ox[oi] : ny = oy[oi]
 if joy0left then nx = nx - amt
 if joy0right then nx = nx + amt
 gosub trymove
 nx = ox[oi] : ny = oy[oi]
 if joy0up then ny = ny - amt
 if joy0down then ny = ny + amt
 gosub trymove
 goto playerfire

playerfire
 if !firepressed then return
 ot = otype[oi]
 oj = typeshoots[ot]
 if oj = EMPTY then return
 rem one shot of each kind on screen at a time
 for count = 0 to 23
 if otype[count] = oj then return
 next
 wid = typew[ot]
 nx = ox[oi] + wid / 2
 wid = typew[oj]
 nx = nx - wid / 2
 hgt = typeh[oj]
 ny = oy[oi] - hgt
 gosub spawnobj
 {{{shootSound}}}
 return

b_patrol_h
 if amt = 0 then return
 nx = ox[oi] : ny = oy[oi]
 if odx[oi] = 1 then nx = nx + amt else nx = nx - amt
 gosub trymove
 if blocked then odx[oi] = odx[oi] ^ 254
 return

b_patrol_v
 if amt = 0 then return
 nx = ox[oi] : ny = oy[oi]
 if ody[oi] = 1 then ny = ny + amt else ny = ny - amt
 gosub trymove
 if blocked then ody[oi] = ody[oi] ^ 254
 return

b_bounce
 if amt = 0 then return
 gosub b_patrol_h
 goto b_patrol_v

b_chase
 if amt = 0 then return
 if heroi = EMPTY then return
 nx = ox[oi] : ny = oy[oi]
 px = ox[heroi]
 if nx < px then nx = nx + amt
 if nx > px then nx = nx - amt
 gosub trymove
 nx = ox[oi] : ny = oy[oi]
 py = oy[heroi]
 if ny < py then ny = ny + amt
 if ny > py then ny = ny - amt
 goto trymove

b_flee
 if amt = 0 then return
 if heroi = EMPTY then return
 nx = ox[oi] : ny = oy[oi]
 px = ox[heroi]
 if nx < px then nx = nx - amt
 if nx >= px then nx = nx + amt
 gosub trymove
 nx = ox[oi] : ny = oy[oi]
 py = oy[heroi]
 if ny < py then ny = ny - amt
 if ny >= py then ny = ny + amt
 goto trymove

b_march
 rem marchers move as one formation, bouncing off the screen edges (not walls)
 px = ox[oi]
 if marchdir = 1 then px = px + amt else px = px - amt
 ox[oi] = px
 if px < marchmin then marchmin = px
 px = px + typew[ot]
 if px > marchmax then marchmax = px
 return

turnmarch
 marchdir = marchdir ^ 254
 for oj = 0 to 23
 ot = otype[oj]
 if ot = EMPTY then goto nextmarch
 if typebeh[ot] = 8 then oy[oj] = oy[oj] + 8
nextmarch
 next
 return

b_fall
 if amt = 0 then return
 oy[oi] = oy[oi] + amt
 if oy[oi] < 184 then return
 rem off the bottom: come back at the top somewhere new
 oy[oi] = ROOMTOP
 rnd = rand & 15
 ox[oi] = rnd * 8 + 8
 return

b_proj_up
 ny = oy[oi] - amt - amt - 2
 nx = ox[oi]
 if ny < ROOMTOP || ny > 200 then otype[oi] = EMPTY : return
 gosub trymove
 if blocked then otype[oi] = EMPTY
 return

b_proj_down
 ny = oy[oi] + amt + 1
 nx = ox[oi]
 if ny > 184 then otype[oi] = EMPTY : return
 gosub trymove
 if blocked then otype[oi] = EMPTY
 return

 {{#if hasVelocity}}
 rem ---- model v2 spike: velocity movement ----
 rem b_velocity: add the velocity (doubled when amt = 2, for time-sliced
 rem movers) to the quarter-pixel fraction; whole pixels move the thing,
 rem one axis at a time, and a wall or edge in the way calls its reaction
b_velocity
 rnd = ovx[oi]
 if rnd = 0 then goto velocityy
 if amt = 2 then rnd = rnd + rnd
 rnd = rnd + ofx[oi]
 ofx[oi] = rnd & 3
 cell = rnd / 4
 if rnd >= 128 then cell = cell | 192
 if cell = 0 then goto velocityy
 nx = ox[oi] + cell : ny = oy[oi]
 gosub trymove
 if !blocked then goto velocityy
 beh = typereact[ot]
 on beh gosub hitstopx hitbouncex hitwrapx hitturn hitdestroy
 if otype[oi] = EMPTY then return
velocityy
 rnd = ovy[oi]
 if rnd = 0 then return
 if amt = 2 then rnd = rnd + rnd
 rnd = rnd + ofy[oi]
 ofy[oi] = rnd & 3
 cell = rnd / 4
 if rnd >= 128 then cell = cell | 192
 if cell = 0 then return
 nx = ox[oi] : ny = oy[oi] + cell
 gosub trymove
 if !blocked then return
 beh = typereact[ot]
 on beh goto hitstopy hitbouncey hitwrapy hitturn hitdestroy

hitstopx
 ovx[oi] = 0
 return
hitbouncex
 rnd = ovx[oi] : ovx[oi] = 0 - rnd
 return
hitwrapx
 rem the screen edges wrap round; walls stop
 px = nx + wid - 1
 if nx < 160 && px < 160 then goto hitstopx
 rnd = ovx[oi]
 if rnd < 128 then ox[oi] = 0 else ox[oi] = 160 - wid
 return
hitstopy
 ovy[oi] = 0
 return
hitbouncey
 rnd = ovy[oi] : ovy[oi] = 0 - rnd
 return
hitwrapy
 py = ny + hgt - 1
 if ny >= ROOMTOP && py < 192 then goto hitstopy
 rnd = ovy[oi]
 if rnd < 128 then oy[oi] = ROOMTOP else oy[oi] = 192 - hgt
 return
hitturn
 rem a quarter turn clockwise: right becomes down, down becomes left
 rnd = ovx[oi] : cell = ovy[oi]
 ovx[oi] = 0 - cell : ovy[oi] = rnd
 return
hitdestroy
 otype[oi] = EMPTY
 return
{{/if}}

 rem drops: a type can drop another (bombs, eggs) at random, one at a time
drops
 ot = otype[oi]
 if ot = EMPTY then return
 oj = typedrops[ot]
 if oj = EMPTY then return
 rnd = rand
 if rnd > typedropchance[ot] then return
 for count = 0 to 23
 if otype[count] = oj then return
 next
 wid = typew[ot]
 nx = ox[oi] + wid / 2
 wid = typew[oj]
 nx = nx - wid / 2
 hgt = typeh[ot]
 ny = oy[oi] + hgt
 goto spawnobj

 rem spawnobj: a new object of type j at (nx, ny) in the first free slot
spawnobj
 rem launched objects live after the placed ones, so each placed type keeps its own slot range
 for count = LAUNCHSTART to 23
 if otype[count] = EMPTY then goto spawnhere
 next
 return
spawnhere
 otype[count] = oj
{{#if hasTimedTurns}}
 otimer[count] = 0
{{/if}}
 ox[count] = nx : oy[count] = ny
 osx[count] = nx : osy[count] = ny
 odx[count] = 1 : ody[count] = 1
{{#if hasVelocity}}
 ovx[count] = typevx[oj] : ovy[count] = typevy[oj]
 ofx[count] = 0 : ofy[count] = 0
{{/if}}
 return

{{#if hasTimedTurns}}
 rem turnback: count down slot tk's timed turn; at zero it turns back
turnback
 tk = secondtick
 if otimer[tk] = 0 then return
 if otype[tk] = EMPTY then otimer[tk] = 0 : return
 otimer[tk] = otimer[tk] - 1
 if otimer[tk] = 0 then otype[tk] = oback[tk]
 return
{{/if}}

 rem ---- rules (generated from the project) ----
rules
{{{rules}}}
 return

{{{ruleActions}}}

 rem ---- drawing (generated) ----
{{{drawRoutines}}}

drawtitle
{{{titleText}}}
 return
drawwon
{{{winText}}}
 return
drawlost
{{{loseText}}}
 return

 rem ---- data (generated) ----
{{{dataTables}}}

{{{soundData}}}
